            ::= { commandsEntry 55 }

        
        cmdExcMuteOnLossOfSyncInformation OBJECT-TYPE
            SYNTAX SwitchOnOff
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Allows a best effort SFN network if switched off.
                This prevents muting on loss of synchronization information,
                e.g. when no Mobile DTV content is present."
            ::= { commandsEntry 61 }

        

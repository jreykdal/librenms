--
-- Textual conventions
--
    
        LogbookFrame ::= TEXTUAL-CONVENTION
            DISPLAY-HINT 
                "4d 0ae0an0at0ar0ai0ae0as0a,0a 0af0ai0ar0as0at0a:0a 4d 1d 1d 4d 2d-1d-1d,1d:1d:1d,1a1d:1d0d"
            STATUS current
            DESCRIPTION 
                "A binary data structure for a complete logbook. 
                All fields are integers in big endian order.
                The DISPLAY-HINT ends after the first logbook entry. 
                
                field  octets  contents            range    description
                -----  ------  --------            -----    -----------
                  1     1-4    nr of entries       0..255   number of entries in the logbook
                
                the first entry (if nr of entries > 0):
                  2     5-8    number              1..255   a decreasing number from max 255 
                  3     9      type                1..3     see TC EventClass
                  4     10     slope               1..2     see TC LogbookEntrySlope
                  5     11-14  message ID                   see TC's LogbookEntryMessages...
                  6     15-16  year
                  7     17     month               1..12
                  8     18     day                 1..31
                  9     19     hour                0..23
                 10     20     minute              0..59
                 11     21     second              0..59
                 12     22     direction from UTC  '+','-'  ASCII characters 2Bh and 2Dh
                 13     23     hours from UTC      0..14
                 14     24     minutes from UTC    0..59
                 
                the second entry (if nr of entries > 1):
                 15-27  25-44  ...
                
                the next entries (if nr of entries > 2):
                 28...   45...
                "
            SYNTAX OCTET STRING (SIZE (4..5104))

    

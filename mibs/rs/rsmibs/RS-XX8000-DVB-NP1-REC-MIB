    productInformationEntry OBJECT-TYPE
      SYNTAX ProductInformationEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An entry for a transmitter with receiver module."
      INDEX { prodInfoTxIdx }
      ::= { productInformationTable 1 }

    
    ProductInformationEntry ::=
      SEQUENCE { 
        prodInfoTxIdx
          IndexTransmitter,
        prodInfoSerialNumber
          Integer32,
        prodInfoVersionNumberSW
          ReadableString,
        prodInfoIdentNumberHW
          ReadableString,
        prodInfoVersionNumberHW
          ReadableString
       }

    prodInfoTxIdx OBJECT-TYPE
      SYNTAX IndexTransmitter
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The transmitter index.
        This value indicates the transmitter number, where the receiver module is built in."
      ::= { productInformationEntry 1 }

    
    prodInfoSerialNumber OBJECT-TYPE

        onePer4(4),
        undef(5)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "DVB-Receiver Input guard interval 
        onePer32(1) --> 1/32  
        onePer16(2) --> 1/16  
        onePer8(3)  --> 1/8  
        onePer4(4)  --> 1/4
        undef(5)    --> undefined"
      ::= { measureValuesEntry 5 }

    
    measureValuesConstellation OBJECT-TYPE
      SYNTAX INTEGER
        {
        qpsk(1),
        qam16(2),
        qam64(3),
        undef(4)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "DVB-Receiver Input constellation
        qpsk(1)  --> QPSK  
        qam16(2) --> 16 QAM  
        qam64(3) --> 64 QAM    
        undef(4) --> not defined"
      ::= { measureValuesEntry 6 }

    
    measureValuesHierarchy OBJECT-TYPE
      SYNTAX INTEGER
        {
        none(1),
        alpha1(2),
        alpha2(3),
        alpha4(4),
        undef(5)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "DVB-Receiver Input hierarchy

    eventsReceiverTable OBJECT-TYPE
      SYNTAX SEQUENCE OF EventsReceiverEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "This table contains necessary informations for handling alarms. 
        For each alarm you have the following informations: 
        - name (get),
        - mask to enable/disable sending out (set/get),
        - priority (set/get) and 
        - the current state (get only)."
      ::= { eventReceiver 1 }

    
    eventsReceiverEntry OBJECT-TYPE
      SYNTAX EventsReceiverEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An event entry always consists of 4 values:
        - name: an enumerated list of all possible notifications
        - mask: the corresponding mask (enable/disable)
        - priority: the corresponding priority (value in range 0..255)
        - event: the event itself (active/inactive)"
      INDEX { eventRecTxIdx, eventRecInputIdx, eventRecNameIdx }
      ::= { eventsReceiverTable 1 }

    
    EventsReceiverEntry ::=
      SEQUENCE { 
        eventRecTxIdx
          IndexTransmitter,
        eventRecInputIdx
          INTEGER,
        eventRecNameIdx
          EventMaxEntryNumber,
        eventRecName
          INTEGER,
        eventRecMask
          EventMask,
        eventRecPriority
          EventPriority,
        eventRecEvent
          EventState
       }

    eventRecTxIdx OBJECT-TYPE
      SYNTAX IndexTransmitter
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The transmitter index.
        This is a helper column and therefore not-accessible.."
      ::= { eventsReceiverEntry 1 }

    
    eventRecInputIdx OBJECT-TYPE
      SYNTAX INTEGER
        {
        input1(1),
        input2(2)
        }
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The input index.
        This is a helper column and therefore not-accessible.."
      ::= { eventsReceiverEntry 2 }

    
    eventRecNameIdx OBJECT-TYPE
      SYNTAX EventMaxEntryNumber
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The event number as integer.
        This is a helper column and therefore not-accessible."
      ::= { eventsReceiverEntry 3 }

    
    eventRecName OBJECT-TYPE
      SYNTAX INTEGER
        {
        recSummaryFault(1),
        recSummaryWarning(2),
        recLocal(3),
        obsoleteRecRfOn(4),
        recNoConnection(5),
        recInputAutoChanged(6),
        recNoConnectionFault(7),
        recHardwareFault(8),
        recInputAGCLocked(9),
        recInputCarrierLocked(10),
        recInputTPSLocked(11),
        recInputViterbiLocked(12),
        recInputMPEGSyncLocked(13),
        recInputMPEGDataLocked(14),
        recInputMPEGUncorrect(15),
        recInputMERWarning(16),
        recInputBERWarning(17),
        recInputMERFault(18),
        recInputBERFault(19)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The event number as integer and the value as readable text.
        The enumeration correlates with the notifications under eventsTxV2.
        
        Note: RfOn is obsolete!"
      ::= { eventsReceiverEntry 4 }

    
    eventRecMask OBJECT-TYPE
      SYNTAX EventMask
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "See TextualConvention for details."
      ::= { eventsReceiverEntry 5 }

    
    eventRecPriority OBJECT-TYPE
      SYNTAX EventPriority
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "See TextualConvention for details."
      ::= { eventsReceiverEntry 6 }

    
    eventRecEvent OBJECT-TYPE
      SYNTAX EventState
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "See TextualConvention for details."
      ::= { eventsReceiverEntry 7 }

    

--
-- Textual conventions
--
  
    IndexPumpUnit ::= TEXTUAL-CONVENTION
      DISPLAY-HINT 
        "d"
      STATUS current
      DESCRIPTION 
        "The index type of the PUCs (pump unit controllers)."
      SYNTAX Integer32 (1..30)

  
--
-- Node definitions
--
  
    rsXx8000PumpUnit OBJECT-IDENTITY
      STATUS current
      DESCRIPTION 
        "Xx8000 Pump Unit"
      ::= { rsXx8000 100 }

    
-- *****************************************************************************
-- **          object definitions
-- *****************************************************************************
    rsXx8000PumpUnitObjs OBJECT IDENTIFIER ::= { rsXx8000PumpUnit 1 }

    
    commandsPumpUnitTable OBJECT-TYPE
      SYNTAX SEQUENCE OF CommandsPumpUnitEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "This table contains the setup and configuration parameters."
      ::= { rsXx8000PumpUnitObjs 1 }

    
    commandsPumpUnitEntry OBJECT-TYPE
      SYNTAX CommandsPumpUnitEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An entry for a designated pump unit or pump unit controller (PUC)."
      INDEX { cmdPuTxIdx, cmdPuOstIdx, cmdPuPumpUnitIdx }
      ::= { commandsPumpUnitTable 1 }

    
    CommandsPumpUnitEntry ::=
      SEQUENCE { 
        cmdPuTxIdx
          IndexTransmitter,
        cmdPuOstIdx
          IndexAB,
        cmdPuNumberOfPumpUnits
          Integer32,
        cmdPuNominalTemp
          FloatingPoint,
        cmdPuWarningTempThreshold
          FloatingPoint,
        cmdPuFaultTempThreshold
          FloatingPoint,
        cmdPuMaxFanSpeed
          Integer32,
        cmdPuAntiFreezeFan
          SwitchOnOff,
        cmdPuPumpUnitIdx
          IndexPumpUnit,
        cmdPuNumberOfPumps
          Integer32,
        cmdPuNumberOfFans
          Integer32,
        cmdPuLiquidFlowCorrection
          Integer32,
        cmdPuServiceMode
          SwitchOnOff
       }

    cmdPuTxIdx OBJECT-TYPE
      SYNTAX IndexTransmitter
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The transmitter index in case of n+1 systems.
        If you have one transmitter only (all reserve concepts except n+1) this index is always 1."
      ::= { commandsPumpUnitEntry 1 }

    
    cmdPuOstIdx OBJECT-TYPE
      SYNTAX IndexAB
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The index of the outputstage.
        If you have a transmitter with one outputstage only (SingleTx, DualDrive),
        this index is always 1."
      ::= { commandsPumpUnitEntry 2 }

    
    cmdPuNumberOfPumpUnits OBJECT-TYPE
      SYNTAX Integer32 (0..30)
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The number of pump units for the transmitting system.
        You have to restart the NetCCU to activate this."
      ::= { commandsPumpUnitEntry 3 }

    
    cmdPuNominalTemp OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "Degree Celsius"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The nominal value of the outlet temperature (25.0 ... 40.0).
        This setting is valid for all pump units of this outputstage.
        You have to restart the NetCCU to activate this."
      ::= { commandsPumpUnitEntry 4 }

    
    cmdPuWarningTempThreshold OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "Degree Celsius"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The value of the warning threshold for outlet temperature (40.0 ... 57.0).
        This setting is valid for all pump units of this outputstage.
        You have to restart the NetCCU to activate this."
      ::= { commandsPumpUnitEntry 5 }

    
    cmdPuFaultTempThreshold OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "Degree Celsius"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The value of the fault threshold for outlet temperature (45.0 ... 62.0).
        This setting is valid for all pump units of this outputstage.
        You have to restart the NetCCU to activate this."
      ::= { commandsPumpUnitEntry 6 }

    
    cmdPuMaxFanSpeed OBJECT-TYPE
      SYNTAX Integer32 (50..100)
      UNITS "Percent"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The maximum fan speed.
        This setting is valid for all pump units of this outputstage."
      ::= { commandsPumpUnitEntry 7 }

    
    cmdPuAntiFreezeFan OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This switches the AntiFreeze on/off.
        To avoid freezing when temperature is too low, the fan will be switched on at times."
      ::= { commandsPumpUnitEntry 8 }

    
    cmdPuPumpUnitIdx OBJECT-TYPE
      SYNTAX IndexPumpUnit
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The pump unit index."
      ::= { commandsPumpUnitEntry 9 }

    
    cmdPuNumberOfPumps OBJECT-TYPE
      SYNTAX Integer32 (0..2)
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The configured number of pumps (stored inside of PUC).
        This value is read-only! It is set and saved during configuration."
      ::= { commandsPumpUnitEntry 10 }

    
    cmdPuNumberOfFans OBJECT-TYPE
      SYNTAX Integer32 (0..4)
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The configured number of fans (stored inside of PUC).
        This value is read-only! It is set and saved during configuration."
      ::= { commandsPumpUnitEntry 11 }

    
    cmdPuLiquidFlowCorrection OBJECT-TYPE
      SYNTAX Integer32 (0..20)
      UNITS "Percent"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "To avoid noise by vibrating pipes
        or to add additional liquid cooled components
        or if a liquid different to Antifrogen N is used,
        it's possible to enhance the flow."
      ::= { commandsPumpUnitEntry 12 }

    
    cmdPuServiceMode OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Switches the service mode on/off.
        No PUC-Fault will switch the transmitter off if PUC is in Service Mode.
        When operating in service mode, all signalling to outputstage and NetCCU is suppressed."
      ::= { commandsPumpUnitEntry 13 }

    
    summaryInfo OBJECT IDENTIFIER ::= { rsXx8000PumpUnitObjs 2 }

    
    statusTable OBJECT-TYPE

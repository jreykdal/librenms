    statusLinkedRacks OBJECT-TYPE
      SYNTAX ReadableString
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Rack linkage of PUC:
        This PUC is connected to the racks with the shown logical numbers."
      ::= { statusEntry 8 }

    
    detailedInfo OBJECT IDENTIFIER ::= { rsXx8000PumpUnitObjs 3 }

    

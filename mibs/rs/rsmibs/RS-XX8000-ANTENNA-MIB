    eventsAntennaRedundancyTable OBJECT-TYPE
      SYNTAX SEQUENCE OF EventsAntennaRedundancyEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "This table contains necessary information for handling alarms. 
        For each alarm you have the following information: 
        - name (get),
        - mask to enable/disable sending out (set/get),
        - priority (set/get) and 
        - the current state (get only)."
      ::= { eventAntennaRedundancy 1 }

    
    eventsAntennaRedundancyEntry OBJECT-TYPE
      SYNTAX EventsAntennaRedundancyEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An event entry always consists of 4 values:
        - name: an enumerated list of all possible notifications
        - mask: the corresponding mask (enable/disable)
        - priority: the corresponding priority value
        - event: the event itself (active/inactive)"
      INDEX { eventAntProgramIdx,
              eventAntSubIdx,
              eventAntNameIdx }
      ::= { eventsAntennaRedundancyTable 1 }

    
    EventsAntennaRedundancyEntry ::=
      SEQUENCE { 
        eventAntProgramIdx
          IndexAntennaProgram,
        eventAntSubIdx
          IndexAntennaSub,
        eventAntNameIdx
          EventMaxEntryNumber,
        eventAntName
          INTEGER,
        eventAntMask
          EventMask,
        eventAntPriority
          EventPriority,
        eventAntEvent
          EventState
       }

    eventAntProgramIdx OBJECT-TYPE
      SYNTAX IndexAntennaProgram
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The program index."
      ::= { eventsAntennaRedundancyEntry 1 }

    
    eventAntSubIdx OBJECT-TYPE
      SYNTAX IndexAntennaSub
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The subindex. See description of IndexAntennaSub."
      ::= { eventsAntennaRedundancyEntry 2 }

    
    eventAntNameIdx OBJECT-TYPE
      SYNTAX EventMaxEntryNumber
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The event number as index.
        This is a helper column and therefore not-accessible."
      ::= { eventsAntennaRedundancyEntry 3 }

    
    eventAntName OBJECT-TYPE
      SYNTAX INTEGER
        {
        summaryFault(1),
        summaryWarning(2),
        automaticReady(3),
        modeManual(4),
        modeAutomatic(5),
        modeEmergency(6),

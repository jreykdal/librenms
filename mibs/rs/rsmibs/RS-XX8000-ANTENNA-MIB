    rsXx8000AntennaRedundMibModule MODULE-IDENTITY 
      LAST-UPDATED "200905110800Z"
      ORGANIZATION 
        "Rohde&Schwarz GmbH & Co. KG"
      CONTACT-INFO 
        "Torsten Huebscher
        Department 7TS2
        Broadcasting Division
        Muehldorfstrasse 15
        81671 Munich, Germany
        torsten.huebscher@rohde-schwarz.com"
      DESCRIPTION 
        "This MIB defines antenna redundancy of transmitting systems from Rohde & Schwarz.
        
        Use this MIB if your system meets the following requirements:
        - series XX8000 (NetCCU800),
        - variant Nplus1 with antenna redundancy.
        
        The following MIBs are related to this:
        - RS-COMMON-MIB         - mandatory for this MIB
        - RS-XX8000-COMMON-MIB  - mandatory for this MIB"
        
      REVISION "200905110800Z"
      DESCRIPTION 
        "new groups and compliance statement for variant NTx"
        
      REVISION "200901231130Z"
      DESCRIPTION 
        "statusTable added"
        
      REVISION "200808050900Z"
      DESCRIPTION 
        "Added emergencySwitch"
        
      REVISION "200805070900Z"
      DESCRIPTION 
        "Initial version."
      ::= { rsXx8000MibModule 101 }

    
  
    rsXx8000AntennaRedundancy OBJECT-IDENTITY
      STATUS current
      DESCRIPTION 
        "Xx8000 Antenna Redundancy"
      ::= { rsXx8000 101 }

    
-- Textual conventions
  
    IndexAntennaProgram ::= TEXTUAL-CONVENTION
      STATUS current
      DESCRIPTION 
        "The program index for antenna redundancy."
      SYNTAX INTEGER
        {
        program1(1),
        program2(2),
        program3(3),
        program4(4)
        }

    IndexAntennaSub ::= TEXTUAL-CONVENTION
      STATUS current
      DESCRIPTION 
        "The subindex.
         For U-Link parameters this index can be 1..6.
         For Switch parameters this index can be 1..3.
         For all other parameters this index is always 1."
      SYNTAX INTEGER
        {
        subindex1(1),
        subindex2(2),
        subindex3(3),
        subindex4(4),
        subindex5(5),
        subindex6(6)
        }


-- ************************************************************************************
-- **          object definitions
-- ************************************************************************************
    rsXx8000AntennaRedundancyObjs OBJECT IDENTIFIER ::= { rsXx8000AntennaRedundancy 1 }

    
-- configuration

    configuration OBJECT IDENTIFIER ::= { rsXx8000AntennaRedundancyObjs 1 }

    antennaFailTime OBJECT-TYPE
      SYNTAX Integer32 (0..30)
      UNITS "seconds"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Time to elapse for reaction on antenna alarm."
      ::= { configuration 2 }


    antennaTripAlarmTime OBJECT-TYPE
      SYNTAX Integer32 (0..30)
      UNITS "seconds"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Time to elapse for reaction on external trip alarm."
      ::= { configuration 3 }


    antennaOutputLevelThreshold OBJECT-TYPE
      SYNTAX Integer32 (0..100)
      UNITS "percent"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Percentage of nominal power for evaluating reflected power."
      ::= { configuration 4 }


    antennaFailLimit OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "dB"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Reflected power threshold for antenna alarm (-22.0 ... -18.0)."
      ::= { configuration 5 }


    autoTxBTesting OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Switch automatic testing for TxB on or off."
      ::= { configuration 20 }


    autoTxBTestTime OBJECT-TYPE
      SYNTAX TimeOfDay
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Time of day for performing the TxB automatic test sequence.
         Seconds are not used."
      ::= { configuration 21 }


    autoTxBTestCycle OBJECT-TYPE
      SYNTAX Integer32 (1..100)
      UNITS "days"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Number of days between each test sequence."
      ::= { configuration 22 }


    autoTxBNextTest OBJECT-TYPE
      SYNTAX Integer32 (0..100)
      UNITS "days"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Number of days left for next test sequence."
      ::= { configuration 23 }


    autoTxBTestDuration OBJECT-TYPE
      SYNTAX TimeOfDay
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Duration of each parameter set test in TxB test sequence.
        Seconds are not used."
      ::= { configuration 24 }


    autoTxBInclusionTable OBJECT-TYPE
      SYNTAX SEQUENCE OF AutoTxBInclusionEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "Inclusion list for automatic TxB test sequence."
      ::= { configuration 30 }

    
    autoTxBInclusionEntry OBJECT-TYPE
      SYNTAX AutoTxBInclusionEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An entry for the inclusion list."
      INDEX { autoTxBInclusionIdx }
      ::= { autoTxBInclusionTable 1 }

    
    AutoTxBInclusionEntry ::=
      SEQUENCE { 
        autoTxBInclusionIdx
          Integer32,
        autoTxBInclusionTestIncluded
          TruthValue
       }

    autoTxBInclusionIdx OBJECT-TYPE
      SYNTAX Integer32 (1..8)
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The inclusion list index. There are at most 8 tests includable."
      ::= { autoTxBInclusionEntry 1 }

    

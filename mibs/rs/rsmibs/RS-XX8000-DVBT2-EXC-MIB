--
-- Textual conventions
--
    
        ValueTypeIndex ::= TEXTUAL-CONVENTION
            STATUS current
            DESCRIPTION 
                "This textual convention is for distinguishing instances
                of a configuration object:
                granted(1)
                - The instance shows the accepted value.
                  This instance is read-only.
                customerSpecified(2)
                - The instance is for changing the value.
                  The exciter software checks whether the new value is admissible
                  with respect to the other customer specified values.
                  If not, the granted value will not change.
                active(3)
                - The instance shows the currently active value.
                  This instance is read-only."
            SYNTAX INTEGER
                {
                granted(1),
                customerSpecified(2),
                active(3)
                }

    
--
-- Node definitions
--
    
        rsXx8000DvbT2Exc OBJECT-IDENTITY
            STATUS current
            DESCRIPTION 
                "Xx8000 DVB-T2 exciter."
            ::= { rsXx8000 212 }

        
        rsXx8000DvbT2ExcObjs OBJECT IDENTIFIER ::= { rsXx8000DvbT2Exc 1 }

        
        identificationTable OBJECT-TYPE
            SYNTAX SEQUENCE OF IdentificationEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "Settings for transmitter identification."
            ::= { rsXx8000DvbT2ExcObjs 1 }

        
        identificationEntry OBJECT-TYPE
            SYNTAX IdentificationEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "An entry for a designated device."
            INDEX { idTxIdx, idExcIdx }
            ::= { identificationTable 1 }

        
        IdentificationEntry ::=
            SEQUENCE { 
                idTxIdx
                    IndexTransmitter,
                idExcIdx
                    IndexAB,
                idTxID
                    Integer32,
                idCellID
                    Integer32,
                idNetworkID
                    Integer32,
                idT2SystemID
                    Integer32
             }

        idTxIdx OBJECT-TYPE
            SYNTAX IndexTransmitter
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "The transmitter index. "
            ::= { identificationEntry 1 }

        
        idExcIdx OBJECT-TYPE
            SYNTAX IndexAB
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "This index distinguishes the exiters.
                Necessary if you have dual drive transmitters."
            ::= { identificationEntry 2 }

        
        idTxID OBJECT-TYPE
            SYNTAX Integer32 (0..65535)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Availability of transmitter identification signals within the current geographic cell.
                When no transmitter identification signals are used this field is set to 0.
                All other bit combinations are reserved for future use."
            ::= { identificationEntry 3 }

        
        idCellID OBJECT-TYPE
            SYNTAX Integer32 (0..65535)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This ID uniquely identifies a geographic cell in a DVB-T2 network.
                A DVB-T2 cell coverage area may consist of one or more frequencies,
                depending on the number of frequencies used per T2 system.
                If the provision of the cell ID is not foreseen, this field shall be set to 0."
            ::= { identificationEntry 4 }

        
        idNetworkID OBJECT-TYPE
            SYNTAX Integer32 (0..65535)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This ID uniquely identifies the current DVB-T2 network."
            ::= { identificationEntry 5 }

        
        idT2SystemID OBJECT-TYPE
            SYNTAX Integer32 (0..65535)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This ID uniquely identifies a T2 system within the DVB-T2 network."
            ::= { identificationEntry 6 }

        
        configTable OBJECT-TYPE
            SYNTAX SEQUENCE OF ConfigEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "General configuration."
            ::= { rsXx8000DvbT2ExcObjs 2 }

        
        configEntry OBJECT-TYPE
            SYNTAX ConfigEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "An entry for a designated device."
            AUGMENTS { identificationEntry }
            ::= { configTable 1 }

        
        ConfigEntry ::=
            SEQUENCE { 
                cfgNetworkMode
                    INTEGER,
                cfgSource
                    INTEGER,
                cfgIdSource
                    INTEGER,
                cfgL1FreqSource
                    INTEGER,
                cfgL1Frequency
                    Unsigned32,
                cfgMisoGroupSource
                    INTEGER,
                cfgT2MiInterface
                    SwitchOnOff,
                cfgT2MiPID
                    Unsigned32,
                cfgTxTimeOffsetSource
                    INTEGER,
                cfgT2MiDejitterBuffer
                    Unsigned32,
                cfgT2MiStaticSinglePLP
                    SwitchOnOff
             }

        cfgNetworkMode OBJECT-TYPE
            SYNTAX INTEGER
                {
                mfn(1),
                sfn(2)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Network Mode."
            ::= { configEntry 3 }

        
        cfgSource OBJECT-TYPE
            SYNTAX INTEGER
                {
                manual(1),
                l1(2)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Selects the configuration mode:
                manual or automatic from the L1 data.
                
                For TSE800 devices this value is read-only.
                The configuration mode is then selected with cfgT2MiInterface:
                on(1)  - configuration source L1 data
                off(2) - configuration source manual"
            ::= { configEntry 4 }

        
        cfgIdSource OBJECT-TYPE
            SYNTAX INTEGER
                {
                manual(1),
                l1(2),
                ia(3)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "cell ID Source:
                manual(1) - taken from idCellID
                l1(2)     - taken from L1 frame information
                ia(3)     - individual addressing (only for TSE800)"
            ::= { configEntry 5 }

        
        cfgL1FreqSource OBJECT-TYPE
            SYNTAX INTEGER
                {
                manual(1),
                l1(2)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Selects the source of the L1 frequency:
                manual (from cfgL1Frequency) or automatic from the L1 data."
            ::= { configEntry 6 }

        
        cfgL1Frequency OBJECT-TYPE
            SYNTAX Unsigned32
            UNITS "Hz"
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Defines the L1 frequency if cfgL1FreqSource is manual(1)."
            ::= { configEntry 7 }

        
        cfgMisoGroupSource OBJECT-TYPE
            SYNTAX INTEGER
                {
                manual(2),
                ia(3)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "The MISO group can be configured either manually directly
                on the transmitter or automatically using the
                'Individual Addressing' (IA) data via the DVB_T2 gateway.
                The group can be switched at any time without signal interruption."
            ::= { configEntry 8 }

        
        cfgT2MiInterface OBJECT-TYPE
            SYNTAX SwitchOnOff
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "on(1) - Uses the incoming T2-MI stream from a DVB-T2 gateway
                         to configure the Modulator.
                off(2) - Uses the incoming MPEG transport stream directly
                         as payload for single PLP."
            ::= { configEntry 9 }

        
        cfgT2MiPID OBJECT-TYPE
            SYNTAX Unsigned32 (0..8191)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Only if cfgT2MiInterface is on(1):
                the packet ID of the T2-MI elementary stream."
            ::= { configEntry 10 }

        
        cfgTxTimeOffsetSource OBJECT-TYPE
            SYNTAX INTEGER
                {
                off(1),
                ia(2)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Source for transmitter specific transmitting delay.
                If a T2-MI interface is used, you may choose:
                ia(2)  - take from IA parameters
                off(1) - deactivated
                If TS feed is used, no choice is possible."
            ::= { configEntry 11 }

        
        cfgT2MiDejitterBuffer OBJECT-TYPE
            SYNTAX Unsigned32 (0..1000)
            UNITS "ms"
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Only if cfgT2MiInterface is on(1):
                the de-jitter buffer delay."
            ::= { configEntry 12 }

        
        cfgT2MiStaticSinglePLP OBJECT-TYPE
            SYNTAX SwitchOnOff
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Only if cfgT2MiInterface is on(1):
                This allows to adapt the internal processing to the configuration in the T2MI stream. 
                None: This is suitable for all configurations. Static Single PLP: A shorter processing 
                delay is achieved by assuming, that there is only one PLP with PLP_NUM_BLOCKS 
                equal to PLP_NUM_BLOCKS_MAX. "
            ::= { configEntry 13 }

        
-- Configuration possibilities for manual configuration.
        configSourceManual OBJECT IDENTIFIER ::= { rsXx8000DvbT2ExcObjs 3 }

        
        channelTable OBJECT-TYPE
            SYNTAX SEQUENCE OF ChannelEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "Channel Configuration."
            ::= { configSourceManual 1 }

        
        channelEntry OBJECT-TYPE
            SYNTAX ChannelEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "An entry for a designated device and value type."
            INDEX { idTxIdx, idExcIdx, chValueTypeIdx }
            ::= { channelTable 1 }

        
        ChannelEntry ::=
            SEQUENCE { 
                chValueTypeIdx
                    ValueTypeIndex,
                chTransmissionFormat
                    INTEGER,
                chBandwidth
                    INTEGER,
                chFFTsize
                    INTEGER,
                chFFTextend
                    SwitchOnOff,
                chGuardIntervall
                    INTEGER,
                chPilotPattern
                    INTEGER,
                chPAPR
                    INTEGER,
                chMisoGroup
                    INTEGER
             }

        chValueTypeIdx OBJECT-TYPE
            SYNTAX ValueTypeIndex
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "see description of ValueTypeIndex"
            ::= { channelEntry 3 }

        
        chTransmissionFormat OBJECT-TYPE
            SYNTAX INTEGER
                {
                siso(1),
                miso(2)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Transmission format.
                miso(2) for TSE800 only."
            ::= { channelEntry 4 }

        
        chBandwidth OBJECT-TYPE
            SYNTAX INTEGER
                {
                mhz5(1),
                mhz6(2),
                mhz7(3),
                mhz8(4)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Channel bandwidth.
                mhz5(1) - 5 MHz
                mhz6(2) - 6 MHz
                mhz7(3) - 7 MHz
                mhz8(4) - 8 MHz"
            ::= { channelEntry 5 }

        
        chFFTsize OBJECT-TYPE
            SYNTAX INTEGER
                {
                k2(1),
                k4(2),
                k8(3),
                k1(4),
                k16(5),
                k32(6)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "FFT Size.
                k2(1)  ->  2 K
                k4(2)  ->  4 K
                k8(3)  ->  8 K
                k1(4)  ->  1 K
                k16(5) -> 16 K
                k32(6) -> 32 K"
            ::= { channelEntry 6 }

        
        chFFTextend OBJECT-TYPE
            SYNTAX SwitchOnOff
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "When this field is set to on(1), the extended carrier mode is used.
                If this field is set to off(2), the normal carrier mode is used.
                Only for 8K, 16K or 32K FFT size."
            ::= { channelEntry 7 }

        
        chGuardIntervall OBJECT-TYPE
            SYNTAX INTEGER
                {
                oneDiv32(1),
                oneDiv16(2),
                oneDiv8(3),
                oneDiv4(4),
                oneDiv128(5),
                nineteenDiv128(6),
                nineteenDiv256(7)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Guard interval of the super-frame.
                oneDiv32(1)       -> 1/32
                oneDiv16(2)       -> 1/16
                oneDiv8(3)        -> 1/8
                oneDiv4(4)        -> 1/4
                oneDiv128(5)      -> 1/128
                nineteenDiv128(6) -> 19/128
                nineteenDiv256(7) -> 19/256"
            ::= { channelEntry 8 }

        
        chPilotPattern OBJECT-TYPE
            SYNTAX INTEGER
                {
                pp1(1),
                pp2(2),
                pp3(3),
                pp4(4),
                pp5(5),
                pp6(6),
                pp7(7),
                pp8(8)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "The scattered pilot pattern used for the data OFDM symbols."
            ::= { channelEntry 9 }

        
        chPAPR OBJECT-TYPE
            SYNTAX INTEGER
                {
                none(1),
                ace(2),
                tr(3),
                aceTr(4)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "PAPR reduction used, if any.
                
                If the corresponding frT2Version
                (customerSpecified or active instance)
                is equal v111(1)
                the enumerated values denote the following:
                none(1)  - no PAPR reduction method used
                ace(2)   - Active Constellation Extension (ACE)
                tr(3)    - Tone Reservation (TR)
                aceTr(4) - ACE & TR
                
                If the corresponding frT2Version is v121(2) or higher
                the enumerated values denote the following:
                none(1)  - L1-ACE & P2-TR
                ace(2)   - L1-ACE & ACE
                tr(3)    - L1-ACE & TR
                aceTr(4) - L1-ACE & ACE & TR
                "
            ::= { channelEntry 10 }

        
        chMisoGroup OBJECT-TYPE
            SYNTAX INTEGER
                {
                off(1),
                group1(2),
                group2(3)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Here you can assign one of two MISO groups to the transmitter manually.
                This setting has an effect only if chMisoGroupSource is set to manual(2).
                The value off(1) must not be set."
            ::= { channelEntry 11 }

        

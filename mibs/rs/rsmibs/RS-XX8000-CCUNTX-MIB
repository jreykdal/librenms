-- *****************************************************************************
-- **          NetCCU switchoverunit
-- *****************************************************************************
    switchoverUnit OBJECT IDENTIFIER ::= { rsXx8000CcuNtxObjs 20 }

    
    operationModeAutomatic OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This switches the automatic switching-over of transmitters on or off.
        An equivalent would be pressing ON or OFF at the NSU frontpanel."
      ::= { switchoverUnit 1 }

    
    operationModePriority OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This switches the usage of priorities on or off.
        
        With priorities, you can set for each program a priority. 
        If a fault occurs on a transmitter sending out a program with higher priority, 
        a transmitter sending out a program with a lower priority will be switched to the more important program."
      ::= { switchoverUnit 2 }

    
    delayTime OBJECT-TYPE
      SYNTAX Integer32 (3..120)
      UNITS "second"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Sets the delay time interval of automatic."
      ::= { switchoverUnit 3 }

    
    selectedTxToDummyLoad OBJECT-TYPE
      SYNTAX IndexTransmitter
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The preselected transmitter to dummy load."
      ::= { switchoverUnit 4 }

    
    selectedInputTxB OBJECT-TYPE
      SYNTAX Integer32 (1..9)
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The preselected input of the reserve transmitter."
      ::= { switchoverUnit 5 }

    
    selectedParametersetTxB OBJECT-TYPE
      SYNTAX Integer32 (1..8)
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The preselected parameterset of the reserve transmitter.
        
        This is helpful when configuring the system and if doing tests with switching-over."
      ::= { switchoverUnit 6 }

    
    selectedChannelTxB OBJECT-TYPE
      SYNTAX INTEGER
        {
        undefined(1),
        channel1(2),
        channel2(3),
        channel3(4),
        channel4(5),
        channel5(6),
        channel6(7),
        channel7(8),
        channel8(9)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Both the input and the parameterset of the reserve transmitter.
        This OID is a combination of OIDs selectedInputTxB and selectedParametersetTxB.
        If you want to set this value, TxB (Reserve Transmitter) must be to dummy load.
        The value undefined(1) is only readable - it is not possible to set it (even TxB is to dummyload)."
      ::= { switchoverUnit 7 }

    
    resetOnProgramOff OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "If on, a reset is performed if program switched off."
      ::= { switchoverUnit 8 }

    
    readyAfterChangeover OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "If on, automatic is switched to ready after changeover."
      ::= { switchoverUnit 9 }

    
    automaticReady OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "This indicates the state of the automatic.
        true(1)  --> ready
        false(2) --> not ready
        
        If it's ready, a switching-over (because of preselection or faults in a transmitter sending out a program) is possible."
      ::= { switchoverUnit 10 }

    
    automaticChanged OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "This indicates whether the automatic has switched over automatically.
        true(1)  --> switched over
        false(2) --> not switched over"
      ::= { switchoverUnit 11 }

    
    automaticFault OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "This indicates whether the automatic has a fault.
        true(1)  --> fault
        false(2) --> no fault"
      ::= { switchoverUnit 12 }

    
    loadedTx OBJECT-TYPE
      SYNTAX INTEGER
        {
        undefined(0),
        transmitterB(1),
        transmitterA1(2),
        transmitterA2(3),
        transmitterA3(4),
        transmitterA4(5),
        transmitterA5(6),
        transmitterA6(7),
        transmitterA7(8),
        transmitterA8(9)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The actual loaded Tx."
      ::= { switchoverUnit 13 }

    
    currentInputTxB OBJECT-TYPE
      SYNTAX Integer32 (0..9)
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Shows the actual reserve transmitter input.
        0 means 'undefined'."
      ::= { switchoverUnit 14 }

    
    currentParametersetTxB OBJECT-TYPE
      SYNTAX Integer32 (0..8)
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Shows the actual parameter set of the reserve transmitter.
        0 means 'undefined'."
      ::= { switchoverUnit 15 }

    

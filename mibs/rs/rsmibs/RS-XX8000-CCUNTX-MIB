    rsXx8000CcuNtxObjs OBJECT IDENTIFIER ::= { rsXx8000CcuNtx 1 }

    
    resetAllFaults OBJECT-TYPE
      SYNTAX Trigger
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Reset all faults (in all modules).
        
        Practically you reset the whole system (NetCCU, and of all transmitters all NetCCUs, Exciters, Outputstages).
        An equivalent would be pressing RESET at the NetCCU frontpanel.
        
        A GET will always return idle(1). A SET idle(1) will return NO_ERROR without doing anything."
      ::= { rsXx8000CcuNtxObjs 1 }

    
    summaryFault OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "This indicates a summary fault of the NetCCU.
        true(1)  --> summary fault
        false(2) --> no summary fault
        
        There is a fault of at least one module (e.g. Exciter A of tx A2) which causes this summary fault.
        
        An equivalent would be the LED Fault at the NetCCU frontpanel."
      ::= { rsXx8000CcuNtxObjs 2 }

    
    summaryWarning OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "This indicates a summary warning of the NetCCU.
        true(1)  --> summary warning
        false(2) --> no summary warning
        
        There is a warning of at least one module (e.g. Exciter A of tx A2) which causes this summary warning.
        
        An equivalent would be the LED Warning at the transmitter frontpanel."
      ::= { rsXx8000CcuNtxObjs 3 }

    
    localMode OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "This indicates the local/remote-mode of the NetCCU.
        true(1)  --> local
        false(2) --> remote
        
        The NetCCU is eigther in local-mode or in remote-mode. 
        For security reasons it is not possible to set this value!
        
        An equivalent would the LED Local at the NetCCU frontpanel."
      ::= { rsXx8000CcuNtxObjs 4 }

    
    powerSupply OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "volt"
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Monitoring value of the output voltages of the power supply."

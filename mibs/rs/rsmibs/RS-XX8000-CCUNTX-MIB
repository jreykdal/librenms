    program OBJECT IDENTIFIER ::= { rsXx8000CcuNtxObjs 30 }

    
    programTable OBJECT-TYPE
      SYNTAX SEQUENCE OF ProgramEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "This table contents important values for programs
        (independent of which physical tx is sending out the program)."
      ::= { program 1 }

    
    programEntry OBJECT-TYPE
      SYNTAX ProgramEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An entry for a designated program."
      INDEX { programIdx }
      ::= { programTable 1 }

    
    ProgramEntry ::=
      SEQUENCE { 
        programIdx
          IndexProgram,
        programPriority
          Integer32,
        programOperationMode
          SwitchOnOff,
        programRfOn
          TruthValue
       }

    programIdx OBJECT-TYPE
      SYNTAX IndexProgram
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The program index. There are max. 8 main programs, if you have 8 main transmitters.
        Additionally, there is a reserve program programRes(1)."
      ::= { programEntry 1 }

    
    programPriority OBJECT-TYPE
      SYNTAX Integer32 (0..8)
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The priority for the program. 
        The value 0 means no priority given. The value 1 means highest priority.
        You must switch on OID operationModePriority for using priorities.
        The reserve program has no priority (agent return not-accessible)."
      ::= { programEntry 2 }

    
    programOperationMode OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This switches the program on or off."
      ::= { programEntry 3 }

    
    programRfOn OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The RF is present for the corresponding program 
        (independent of which physical tx is sending out the program)."

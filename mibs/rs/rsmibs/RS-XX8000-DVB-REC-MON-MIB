    rsXx8000DvbRecMonMibModule MODULE-IDENTITY 
      LAST-UPDATED "201001210800Z"		-- January 21, 2010 at 08:00 GMT
      ORGANIZATION 
        "Rohde&Schwarz GmbH & Co. KG"
      CONTACT-INFO 

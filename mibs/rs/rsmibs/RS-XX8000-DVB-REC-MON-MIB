      ::= { rsXx8000MibModule 104 }

    
  
--
-- Textual conventions
--
  
    ErrorRateThreshold ::= TEXTUAL-CONVENTION
      STATUS current
      DESCRIPTION 
        "The values have the following meaning:
        0: off,
        1: 1e-1, 2:1e-2, 3: 1e-3, 4: 1e-4, 5: 1e-5, 6: 1e-6, 7: 1e-7, 8: 1e-8,
        9: 1e-9, 10: 1e-10, 11: 1e-11, 12: 1e-12"
      SYNTAX Integer32 (0..12)

    CodeRate ::= TEXTUAL-CONVENTION
      STATUS current
      DESCRIPTION 
        "Possible code rate values."
      SYNTAX INTEGER
        {
        oneHalf(1),
        twoThird(2),
        threeQuater(3),
        fiveSixth(4),
        sevenEighth(5)
        }

    RoleManagerStatus ::= TEXTUAL-CONVENTION
      STATUS current
      DESCRIPTION 
        "Possible status values for role manager."
      SYNTAX INTEGER
        {
        invalidated(1),
        error(2),
        warning(3),
        ok(4)
        }

  

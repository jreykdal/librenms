    eventsTransposerTable OBJECT-TYPE
      SYNTAX SEQUENCE OF EventsTransposerEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "This table contains necessary information for handling alarms. 
        For each alarm you have the following information: 
        - name (get),
        - mask to enable/disable sending out (set/get),
        - priority (set/get) and 
        - the current state (get only)."
      ::= { eventTransposer 1 }

    
    eventsTransposerEntry OBJECT-TYPE
      SYNTAX EventsTransposerEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An event entry always consists of 4 values:
        - name: an enumerated list of all possible notifications
        - mask: the corresponding mask (enable/disable)
        - priority: the corresponding priority value
        - event: the event itself (active/inactive)"
      INDEX { eventTxIdx, eventNameIdx }
      ::= { eventsTransposerTable 1 }

    
    EventsTransposerEntry ::=
      SEQUENCE { 
        eventTxIdx
          IndexTransmitter,
        eventNameIdx
          EventMaxEntryNumber,
        eventName
          INTEGER,
        eventMask
          EventMask,
        eventPriority
          EventPriority,
        eventValueTransposer
          EventState
       }

    eventTxIdx OBJECT-TYPE
      SYNTAX IndexTransmitter
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The transmitter index in case of NTx or Np1 systems.
        If you have one transmitter only (SingleTx) this index is always 1."
      ::= { eventsTransposerEntry 1 }

    
    eventNameIdx OBJECT-TYPE
      SYNTAX EventMaxEntryNumber
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The event number as index.
        This is a helper column and therefore not-accessible."

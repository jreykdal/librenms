--
-- Textual conventions
--
  
    ProdInfoModuleNameTransposer ::= TEXTUAL-CONVENTION
      STATUS current
      DESCRIPTION 
        "The product information module names for the transposer."
      SYNTAX INTEGER
        {
        transposer(1),
        coder(2),
        rfBoard(4),
        sawFilter(7),
        enhancedEchoCanceller(13),
        amplifier(101)
        }

  
--
-- Node definitions
--
  
    rsXx8000Transposer OBJECT-IDENTITY
      STATUS current
      DESCRIPTION 
        "Xx8000 transposer"
      ::= { rsXx8000 103 }

    
-- ************************************************************************************
-- **          object definitions
-- ************************************************************************************
    rsXx8000TransposerObjs OBJECT IDENTIFIER ::= { rsXx8000Transposer 2 }

    
--     common
    commonTable OBJECT-TYPE
      SYNTAX SEQUENCE OF CommonEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "Table for common parameters."
      ::= { rsXx8000TransposerObjs 1 }

    
    commonEntry OBJECT-TYPE
      SYNTAX CommonEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An entry for the common parameter of a specific transposer."
      INDEX { commonTxIdx }
      ::= { commonTable 1 }

    
    CommonEntry ::=
      SEQUENCE { 
        commonTxIdx
          IndexTransmitter,
        txType
          TvStandard,
        timeScheduler
          SwitchOnOff,
        resetSumFault
          Trigger,
        parametersetLoad
          Integer32,
        parametersetSave
          Integer32,
        parametersetReSave
          Trigger,
        atvStandard
          AtvStandard,
        irtNicam
          INTEGER,
        retransmitter
          INTEGER
       }

    commonTxIdx OBJECT-TYPE
      SYNTAX IndexTransmitter
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The transmitter index in case of NTx or Np1 systems.
        If you have one transmitter only (SingleTx) this index is always 1."
      ::= { commonEntry 1 }

    
    txType OBJECT-TYPE
      SYNTAX TvStandard
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The TV-Standard of the transmitter. Changing the value involves an automatic 
        reboot."
      ::= { commonEntry 5 }

    
    timeScheduler OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "If on, the time scheduler controls the tx type. When switching on the scheduler 
        it may instantly set the correct TV standard and reboot the device."
      ::= { commonEntry 6 }

    
    resetSumFault OBJECT-TYPE
      SYNTAX Trigger
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Reset all faults (in all modules) of the transmitter.
        
        An equivalent would be pressing RESET at this transmitters frontpanel.
        
        A GET will always return idle(1).
        A SET idle(1) will return NO_ERROR without doing anything."
      ::= { commonEntry 7 }

    
    parametersetLoad OBJECT-TYPE
      SYNTAX Integer32 (1..8)
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This loads the desired parameter set."
      ::= { commonEntry 8 }

    
    parametersetSave OBJECT-TYPE
      SYNTAX Integer32 (1..8)
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This saves the current settings to a designated parameter set."
      ::= { commonEntry 9 }

    
    parametersetReSave OBJECT-TYPE
      SYNTAX Trigger
      MAX-ACCESS read-write
      STATUS obsolete
      DESCRIPTION
        "This saves the changes to the current parameter set."
      ::= { commonEntry 10 }

    
    atvStandard OBJECT-TYPE
      SYNTAX AtvStandard
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The selection of the ATV standard."
      ::= { commonEntry 11 }

    
    irtNicam OBJECT-TYPE
      SYNTAX INTEGER
        {
        irt(1),
        nicam(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The switch between IRT and NICAM."
      ::= { commonEntry 12 }

    
    retransmitter OBJECT-TYPE
      SYNTAX INTEGER
        {
        transposer(1),
        transmitter(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "If retransmitter function is active. Changing the value involves an automatic 
        reboot."
      ::= { commonEntry 13 }

    
--     input
    inputTable OBJECT-TYPE
      SYNTAX SEQUENCE OF InputEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "Table for input parameters."
      ::= { rsXx8000TransposerObjs 3 }

    
    inputEntry OBJECT-TYPE
      SYNTAX InputEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An entry for the input parameter of a specific transposer."
      INDEX { inputTxIdx }
      ::= { inputTable 1 }

    
    InputEntry ::=
      SEQUENCE { 
        inputTxIdx
          IndexTransmitter,
        inputFrequency
          Integer32,
        inputMode
          INTEGER,
        manualInputLevel
          Integer32,
        muteOnLowInputLevel
          Integer32,
        warningLevelOffset
          Integer32,
        onInputFail
          INTEGER,
        typeLossOfInput
          INTEGER,
        auxiliaryFilterBoard
          INTEGER,
        inputBandwidth
          INTEGER,
        adjacentChannelSelectivity
          INTEGER,
        inputRfLevel
          FloatingPoint,
        inputFailDelayTime
          Integer32,
        inputChannelPower
          FloatingPoint,
        inputPreselect
          INTEGER,
        inputPriority
          INTEGER,
        inputExpectReserve
          SwitchOnOff,
        inputCheckTimeForward
          Integer32,
        inputCheckTimeSwitchBack
          Integer32,
        inputAutomaticOpMode
          SwitchOnOff,
        inputAutomaticReady
          TruthValue,
        inputAutomaticChangedOver
          TruthValue,
        inputAutomaticReadyAfterChangeover
          SwitchOnOff,
        input1Connected
          TruthValue,
        input2Connected
          TruthValue,
        inputSeamless
          TruthValue,
        inputSeamlessSwitching
          SwitchOnOff,
        inputActive
          INTEGER,
        muteCondition
          INTEGER,
        networkControlInformationFault
          TruthValue
       }

    inputTxIdx OBJECT-TYPE
      SYNTAX IndexTransmitter
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The transmitter index in case of NTx or Np1 systems.
        If you have one transmitter only (SingleTx) this index is always 1."
      ::= { inputEntry 1 }

    
    inputFrequency OBJECT-TYPE
      SYNTAX Integer32 (160000000..910000000)
      UNITS "Hz"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Input frequency."
      ::= { inputEntry 5 }

    
    inputMode OBJECT-TYPE
      SYNTAX INTEGER
        {
        automatic(1),
        manual(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The input mode."
      ::= { inputEntry 6 }

    
    manualInputLevel OBJECT-TYPE
      SYNTAX Integer32 (-75..0)
      UNITS "dBm"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Manually sets the input level."
      ::= { inputEntry 7 }

    
    muteOnLowInputLevel OBJECT-TYPE
      SYNTAX Integer32 (-80..-30)
      UNITS "dBm"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The absolute level of input power to force a mute."
      ::= { inputEntry 8 }

    
    warningLevelOffset OBJECT-TYPE
      SYNTAX Integer32 (0..50)
      UNITS "dB"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The relative offset to the mute level to force a warning."
      ::= { inputEntry 9 }

    
    onInputFail OBJECT-TYPE
      SYNTAX INTEGER
        {
        mute(1),
        noMute(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Controls the output behaviour on input failure."
      ::= { inputEntry 10 }

    
    typeLossOfInput OBJECT-TYPE
      SYNTAX INTEGER
        {
        warning(1),
        fault(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "If the input signal is lost, either a warning or a fault can be generated.
        If you select fault here, a switchover to the reserve exciter will be executed 
        when input signal is lost."
      ::= { inputEntry 11 }

    
    auxiliaryFilterBoard OBJECT-TYPE
      SYNTAX INTEGER
        {
        active(1),
        inactive(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Activate the optional filter board."
      ::= { inputEntry 12 }

    
    inputBandwidth OBJECT-TYPE
      SYNTAX INTEGER
        {
        mHz8(1),
        mHz7(2),
        mHz6(3),
        mHz5(4),
        mHz1point5(5),
        mHz8ext(6),
        mHz7ext(7)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The input bandwidth in MHz."
      ::= { inputEntry 13 }

    
    adjacentChannelSelectivity OBJECT-TYPE
      SYNTAX INTEGER
        {
        off(1),
        selectivity50(2),
        selectivity70(3),
        steepSlope50(4),
        steepSlope70(5)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The channel selectivity in dB."
      ::= { inputEntry 14 }

    
    inputRfLevel OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "dBm"
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Measurement of the total input RF level (wide band)."
      ::= { inputEntry 17 }

    
    inputFailDelayTime OBJECT-TYPE
      SYNTAX Integer32 (0..600)
      UNITS "Seconds"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The time between detecting a loss of input signal and displaying a failure."
      ::= { inputEntry 18 }

    
    inputChannelPower OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "dBm"
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Measurement of the in-channel RF level at the input."
      ::= { inputEntry 19 }

    
    inputPreselect OBJECT-TYPE
      SYNTAX INTEGER
        {
        input1(1),
        input2(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Preselected (if inputAutomatic = off(2)) or
        preferred (i.e. with higher priority) input"
      ::= { inputEntry 20 }

    
    inputPriority OBJECT-TYPE
      SYNTAX INTEGER
        {
        equal(1),
        prior(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "equal(1): There are no differences between both inputs. 
               If a failure on the current input is detected it will be switched to the reserve input. 
               It stays there until the reserve shows a failure. 
        prior(2): Whenever possible the input inputPreselect shall be used. 
               If a failure is detected the reserve will be used as short as possible."
      ::= { inputEntry 21 }

    
    inputExpectReserve OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "If on(1) the warning inputReserveMissing will be generated
        in case second input is missing."
      ::= { inputEntry 22 }

    
    inputCheckTimeForward OBJECT-TYPE
      SYNTAX Integer32 (0..600)
      UNITS "second"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This time has to elapse before the current input switches 
        to the reserve input."
      ::= { inputEntry 23 }

    
    inputCheckTimeSwitchBack OBJECT-TYPE
      SYNTAX Integer32 (0..600)
      UNITS "second"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This time has to elapse before the automatic switches back 
        from the reserve to a preselected input. 
        This value has no effect if the priority is set to equal."
      ::= { inputEntry 24 }

    
    inputAutomaticOpMode OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Switches input automatic on or off."
      ::= { inputEntry 25 }

    
    inputAutomaticReady OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Shows whether input automatic is ready."
      ::= { inputEntry 26 }

    
    inputAutomaticChangedOver OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Input Automatic changed over."
      ::= { inputEntry 27 }

    
    inputAutomaticReadyAfterChangeover OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Input automatic ready after change over."
      ::= { inputEntry 28 }

    
    input1Connected OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The input 1 is connected."
      ::= { inputEntry 29 }

    
    input2Connected OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The input 1 is connected."
      ::= { inputEntry 30 }

    
    inputSeamless OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The input is in seamless mode."
      ::= { inputEntry 31 }

    
    inputSeamlessSwitching OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "If the datastreams on both inputs are synchronised
        a seamless switch is possible. 
        With this parameter the seamless switch can be suppressed
        to enable a check of the input automatic."
      ::= { inputEntry 32 }

    
    inputActive OBJECT-TYPE
      SYNTAX INTEGER
        {
        input1(1),
        input2(2)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The active input."
      ::= { inputEntry 33 }

    
    muteCondition OBJECT-TYPE
      SYNTAX INTEGER
        {
        onAllFaults(1),
        notBeforeSyncLoss(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "When notBeforeSyncLoss(2) is selected,
        it relativizes the onInputFail setting mute(1):
        If a DVB receiver is the last valid input, an existing transport stream,
        even if it is faulty, shall not be muted."
      ::= { inputEntry 34 }

    
    networkControlInformationFault OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "DVB-T, DTMB: MIP fault
        DVB-T2: no L1
        ISDB-T: IIP fault"
      ::= { inputEntry 35 }

    
--     RF Out
    rfOutTable OBJECT-TYPE
      SYNTAX SEQUENCE OF RfOutEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "Table for RF Out parameters."
      ::= { rsXx8000TransposerObjs 4 }

    
    rfOutEntry OBJECT-TYPE
      SYNTAX RfOutEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An entry for the RF Out parameter of a specific transposer."
      INDEX { rfOutTxIdx }
      ::= { rfOutTable 1 }

    
    RfOutEntry ::=
      SEQUENCE { 
        rfOutTxIdx
          IndexTransmitter,
        amplifierOk
          TruthValue,
        powerNominal
          FloatingPoint,
        powerActual
          FloatingPoint,
        powerReflected
          FloatingPoint,
        powerOutput
          FloatingPoint,
        vswr
          FloatingPoint,
        rfFailLimit
          FloatingPoint,
        rfWarningLimit
          FloatingPoint,
        synthesizerFrequency
          Integer32,
        rfOutput
          SwitchOnOff,
        rfSlope
          FloatingPoint,
        modulationSlope
          FloatingPoint
       }

    rfOutTxIdx OBJECT-TYPE
      SYNTAX IndexTransmitter
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The transmitter index in case of NTx or Np1 systems.
        If you have one transmitter only (SingleTx) this index is always 1."
      ::= { rfOutEntry 1 }

    
    amplifierOk OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "If false, output stage signals sum warning."
      ::= { rfOutEntry 4 }

    
    powerNominal OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "W"
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The nominal power."
      ::= { rfOutEntry 5 }

    
    powerActual OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "W"
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The forward power."
      ::= { rfOutEntry 6 }

    
    powerReflected OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "W"
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The reflected power."
      ::= { rfOutEntry 7 }

    
    powerOutput OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "W"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The output power (0.0 ... 440.0)."
      ::= { rfOutEntry 8 }

    
    vswr OBJECT-TYPE
      SYNTAX FloatingPoint
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The VSWR value."
      ::= { rfOutEntry 9 }

    
    rfFailLimit OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "dB"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Fault limit for the RF control (-15.0 ... 0.0)."
      ::= { rfOutEntry 10 }

    
    rfWarningLimit OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "dB"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Warning limit for the RF control (-15.0 ... 0.0)."
      ::= { rfOutEntry 11 }

    
    synthesizerFrequency OBJECT-TYPE
      SYNTAX Integer32 (47000000..1500000000)
      UNITS "Hz"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The channel center frequency."
      ::= { rfOutEntry 64 }

    
    rfOutput OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Turns on/switches off the output signal. This switch takes the same effect as the 
        switch on the frontpanel of the exciter."
      ::= { rfOutEntry 70 }

    
    rfSlope OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "percent"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Adjusts a slope in the RF signal (-50.0 ... 50.0)."
      ::= { rfOutEntry 74 }

    
    modulationSlope OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "percent"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Modulation slope (-50.0 ... 50.0)."
      ::= { rfOutEntry 75 }

    

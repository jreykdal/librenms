-- *****************************************************************************
-- **          NetCCU Tx Control Unit
-- *****************************************************************************
        txControlUnit OBJECT IDENTIFIER ::= { rsXx8000DvbNTxObjs 1 }

        
        resetAllFaults OBJECT-TYPE
            SYNTAX Trigger
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Reset all faults (for NCU - NetCCU Control Unit).
                
                An equivalent would be pressing RESET at the NCU frontpanel.
                
                A GET will always return idle(1). A SET idle(1) will return NO_ERROR without doing anything."
            ::= { txControlUnit 7 }

        
        summaryFaultNCU OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates a summary fault of the NCU - NetCCU Control Unit.
                true(1)  --> summary fault
                false(2) --> no summary fault
                
                There is a fault which causes this summary fault.
                
                An equivalent would be the LED Fault at the NCU frontpanel."
            ::= { txControlUnit 8 }

        
        summaryWarningNCU OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates a summary warning of the NCU - NetCCU Control Unit.
                true(1)  --> summary warning
                false(2) --> no summary warning
                
                There is a warning which causes this summary warning.
                
                An equivalent would be the LED Warning at the NCU frontpanel."
            ::= { txControlUnit 9 }

        
        localModeNCU OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates the local/remote-mode of the NCU - NetCCU Control Unit.
                true(1)  --> local
                false(2) --> remote
                
                The NCU is eigther in local-mode or in remote-mode. 
                For security reasons it is not possible to set this value!
                
                An equivalent would the LED Local at the NCU frontpanel."
            ::= { txControlUnit 10 }

        
        logbookNCU OBJECT IDENTIFIER ::= { txControlUnit 14 }

        
        ncuNumberOfEntries OBJECT-TYPE
            SYNTAX LogbookMaxEntryNumber
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The number of entries in the NCU - NetCCU Control Unit."
            ::= { logbookNCU 1 }

        
        ncuLogbookClear OBJECT-TYPE
            SYNTAX Trigger
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Clear logbook of the NCU - NetCCU Control Unit."
            ::= { logbookNCU 2 }

        
        ncuLogbookTable OBJECT-TYPE
            SYNTAX SEQUENCE OF NcuLogbookEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "NCU Logbook"
            ::= { logbookNCU 3 }

        
        ncuLogbookEntry OBJECT-TYPE
            SYNTAX NcuLogbookEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "A row (an entry) of a logbook."
            INDEX { ncuLogbookEntryIdx }
            ::= { ncuLogbookTable 1 }

        
        NcuLogbookEntry ::=
            SEQUENCE { 
                ncuLogbookEntryIdx
                    LogbookMaxEntryNumber,
                ncuLogbookEntryNbr
                    LogbookMaxEntryNumber,
                ncuLogbookType
                    EventClass,
                ncuLogbookSlope
                    LogbookEntrySlope,
                ncuLogbookMessage
                    LogbookEntryMessagesNSU,
                ncuLogbookDateTime
                    DateAndTime
             }

        ncuLogbookEntryIdx OBJECT-TYPE
            SYNTAX LogbookMaxEntryNumber
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "This is an increasing number from 1 to 128. It is used as an index column for SNMP."
            ::= { ncuLogbookEntry 1 }

        
        ncuLogbookEntryNbr OBJECT-TYPE
            SYNTAX LogbookMaxEntryNumber
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This is the number of the logbook entry. It is an decreasing number from max 128 down to 1."
            ::= { ncuLogbookEntry 2 }

        
        ncuLogbookType OBJECT-TYPE
            SYNTAX EventClass
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Can either be Fault, Warning or State."
            ::= { ncuLogbookEntry 3 }

        
        ncuLogbookSlope OBJECT-TYPE
            SYNTAX LogbookEntrySlope
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Either set (event raises) or reset (event disappears)"
            ::= { ncuLogbookEntry 4 }

        
        ncuLogbookMessage OBJECT-TYPE

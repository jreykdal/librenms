--
-- Node definitions
--
    
        rsXx8000Tx OBJECT-IDENTITY
            STATUS current
            DESCRIPTION 
                "Xx8000 transmitter.
                Several transmitters can be addressed via the cmdTxIdx."
            ::= { rsXx8000 201 }

        
-- *****************************************************************************
-- **          object definitions
-- *****************************************************************************
        rsXx8000TxObjs OBJECT IDENTIFIER ::= { rsXx8000Tx 1 }

        
        commandsTxTable OBJECT-TYPE
            SYNTAX SEQUENCE OF CommandsTxEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "This table contains important commands for the transmitter."
            ::= { rsXx8000TxObjs 1 }

        
        commandsTxEntry OBJECT-TYPE
            SYNTAX CommandsTxEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "An entry (conceptual row) in the commandsTxTable."
            INDEX { cmdTxIdx }
            ::= { commandsTxTable 1 }

        
        CommandsTxEntry ::=
            SEQUENCE { 
                cmdTxIdx
                    IndexTransmitter,
                cmdTxName
                    IndexTransmitter,
                cmdTxResetSumFault
                    Trigger,
                cmdTxParametersetLoad
                    Integer32,
                cmdTxParametersetSave
                    Integer32,
                cmdTxOperationModeProgram
                    SwitchOnOff,
                cmdTxOperationModeReserve
                    SwitchOnOff,
                cmdTxOpModeExcAutomatic
                    SwitchOnOff,
                cmdTxOpModeOstAutomatic
                    SwitchOnOff,
                cmdTxPreselectExciter
                    IndexAB,
                cmdTxPreselectOutputstage
                    INTEGER,
                cmdTxDelayTimeExcAutomatic
                    Integer32,
                cmdTxDelayTimeOstAutomatic
                    Integer32,
                cmdTxRfSwitch
                    INTEGER
             }

        cmdTxIdx OBJECT-TYPE
            SYNTAX IndexTransmitter
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "The transmitter index. "
            ::= { commandsTxEntry 1 }

        
        cmdTxName OBJECT-TYPE
            SYNTAX IndexTransmitter
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This is the logical name for the transmitter."
            ::= { commandsTxEntry 2 }

        
        cmdTxResetSumFault OBJECT-TYPE
            SYNTAX Trigger
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Reset all faults (in all modules) of the transmitter.
                
                You reset a designated transmitter (NetCCU, Exciters, Outputstages).
                An equivalent would be pressing RESET at this transmitters frontpanel.
                
                A GET will always return idle(1). A SET idle(1) will return NO_ERROR without doing anything."
            ::= { commandsTxEntry 3 }

        
        cmdTxParametersetLoad OBJECT-TYPE
            SYNTAX Integer32 (1..8)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This loads the desired parameter set."
            ::= { commandsTxEntry 4 }

        
        cmdTxParametersetSave OBJECT-TYPE
            SYNTAX Integer32 (1..8)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This saves the current settings to a designated parameter set."
            ::= { commandsTxEntry 5 }

        
        cmdTxOperationModeProgram OBJECT-TYPE
            SYNTAX SwitchOnOff
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This switches the program path of the transmitter on/off."
            ::= { commandsTxEntry 7 }

        
        cmdTxOperationModeReserve OBJECT-TYPE
            SYNTAX SwitchOnOff
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This switches the reserve path of the transmitter on/off."
            ::= { commandsTxEntry 8 }

        
        cmdTxOpModeExcAutomatic OBJECT-TYPE
            SYNTAX SwitchOnOff
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This switches the exciter automatic on/off."
            ::= { commandsTxEntry 9 }

        
        cmdTxOpModeOstAutomatic OBJECT-TYPE
            SYNTAX SwitchOnOff
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This switches the outputstage automatic on/off.
                
                This paramter is only available for systems with an automatic output switch."
            ::= { commandsTxEntry 10 }

        
        cmdTxPreselectExciter OBJECT-TYPE
            SYNTAX IndexAB
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This sets exciterA or exciterB to program path (antenna) of the transmitter."
            ::= { commandsTxEntry 11 }

        
        cmdTxPreselectOutputstage OBJECT-TYPE
            SYNTAX INTEGER
                {
                outputstageA(1),
                outputstageB(2),
                bothToAntenna(3),
                bothToDummyLoad(4)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This sets
                - outputstageA or
                - outputstageB or
                - both
                to program path (antenna) of the transmitter,
                or it sets both to dummyload.
                
                The settings bothToAntenna(3) and bothToDummyLoad(4) are only settable
                for ActiveReserve systems.
                
                This paramter is only available for systems with an automatic output switch."
            ::= { commandsTxEntry 12 }

        
        cmdTxDelayTimeExcAutomatic OBJECT-TYPE
            SYNTAX Integer32 (1..60)
            UNITS "seconds"
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This sets the exciter automatic delay time."
            ::= { commandsTxEntry 13 }

        
        cmdTxDelayTimeOstAutomatic OBJECT-TYPE
            SYNTAX Integer32 (1..60)
            UNITS "seconds"
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This sets the outputstage automatic delay time.
                
                This paramter is only available for systems with an automatic output switch."
            ::= { commandsTxEntry 14 }

        
        cmdTxRfSwitch OBJECT-TYPE
            SYNTAX INTEGER
                {
                antenna(1),
                dummyLoad(2)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "RF switch for single-ended systems."
            ::= { commandsTxEntry 15 }

        
        statusTxTable OBJECT-TYPE
            SYNTAX SEQUENCE OF StatusTxEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "This table shows overall information for all transmitters."
            ::= { rsXx8000TxObjs 2 }

        
        statusTxEntry OBJECT-TYPE
            SYNTAX StatusTxEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "An entry for a designated transmitter."
            AUGMENTS { commandsTxEntry }
            ::= { statusTxTable 1 }

        
        StatusTxEntry ::=
            SEQUENCE { 
                statusTxName
                    IndexTransmitter,
                statusTxNoConnection
                    TruthValue,
                statusTxSummaryFault
                    TruthValue,
                statusTxSummaryWarning
                    TruthValue,
                statusTxLocalMode
                    TruthValue,
                statusTxRfOn
                    TruthValue,
                statusTxToBeChanged
                    TruthValue,
                statusTxChangeable
                    TruthValue,
                statusTxForwardPower
                    FloatingPoint,
                statusTxReflectedPower
                    FloatingPoint,
                statusTxSummaryFaultExcA
                    TruthValue,
                statusTxSummaryFaultOstA
                    TruthValue,
                statusTxSummaryFaultExcB
                    TruthValue,
                statusTxSummaryFaultOstB
                    TruthValue,
                statusTxExciterAutomaticReady
                    TruthValue,
                statusTxExciterAutomaticChanged
                    TruthValue,
                statusTxExciterAutomaticFault
                    TruthValue,
                statusTxOstAutomaticReady
                    TruthValue,
                statusTxOstAutomaticChanged
                    TruthValue,
                statusTxOstAutomaticFault
                    TruthValue,
                statusTxNoConnectionExcA
                    TruthValue,
                statusTxNoConnectionOstA
                    TruthValue,
                statusTxNoConnectionExcB
                    TruthValue,
                statusTxNoConnectionOstB
                    TruthValue,
                statusTxActiveExcA
                    TruthValue,
                statusTxActiveOstA
                    TruthValue,
                statusTxActiveExcB
                    TruthValue,
                statusTxActiveOstB
                    TruthValue,
                statusTxExcSwitch
                    INTEGER,
                statusTxOstSwitch
                    INTEGER,
                statusTxNoConnectionApaIf
                    TruthValue,
                statusTxAbsorberFault
                    TruthValue,
                statusTxPowerSupply
                    FloatingPoint,
                statusTxAdditionalPowerSupply
                    TruthValue,
                statusTxInternalPowerSupply
                    FloatingPoint,
                statusTxExternalPowerSupply
                    FloatingPoint
             }

        statusTxName OBJECT-TYPE
            SYNTAX IndexTransmitter
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This is the logical name for the transmitters.
                The reserve transmitter (TxB) always is shown as the first line of a table.
                The other (main, program) transmitters (TxA1, TxA2...) are following."
            ::= { statusTxEntry 2 }

        
        statusTxNoConnection OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "No connection between NSU and transmitter."
            ::= { statusTxEntry 3 }

        
        statusTxSummaryFault OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates a summary fault of the transmitter.
                true(1)  --> summary fault
                false(2) --> no summary fault
                
                There is a fault of at least one module (e.g. Exciter) which causes this summary fault.
                
                An equivalent would be the LED Fault at the transmitters frontpanel."
            ::= { statusTxEntry 4 }

        
        statusTxSummaryWarning OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates a summary warning of the transmitter.
                true(1)  --> summary warning
                false(2) --> no summary warning
                
                There is a fault of at least one module (e.g. Exciter) which causes this summary warning.
                
                An equivalent would be the LED Warning at the transmitters frontpanel."
            ::= { statusTxEntry 5 }

        
        statusTxLocalMode OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates the local/remote-mode of the transmitter.
                true(1)  --> local
                false(2) --> remote
                
                The transmitter is eigther in local-mode or in remote-mode.
                For security reasons it is not possible to set this value!
                
                An equivalent would the LED Local at the transmitters frontpanel."
            ::= { statusTxEntry 6 }

        
        statusTxRfOn OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Shows whether RF is present for the corresponding transmitter."
            ::= { statusTxEntry 7 }

        
        statusTxToBeChanged OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Tx is to be changed."
            ::= { statusTxEntry 8 }

        
        statusTxChangeable OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Tx is changeable."
            ::= { statusTxEntry 9 }

        
        statusTxForwardPower OBJECT-TYPE
            SYNTAX FloatingPoint
            UNITS "Watt"
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The measured forwarded power [W]."
            ::= { statusTxEntry 13 }

        
        statusTxReflectedPower OBJECT-TYPE
            SYNTAX FloatingPoint
            UNITS "Watt"
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The measured reflected power [W] (not available for lowpower)."
            ::= { statusTxEntry 14 }

        
        statusTxSummaryFaultExcA OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates a summary fault of exciter."
            ::= { statusTxEntry 15 }

        
        statusTxSummaryFaultOstA OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates a summary fault of outputstage."
            ::= { statusTxEntry 16 }

        
        statusTxSummaryFaultExcB OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates a summary fault of exciter."
            ::= { statusTxEntry 17 }

        
        statusTxSummaryFaultOstB OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates a summary fault of outputstage."
            ::= { statusTxEntry 18 }

        
        statusTxExciterAutomaticReady OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The Exciter Automatic is Ready.
                In case of any fault on one exciter, there will be a switchover to the other exciter."
            ::= { statusTxEntry 19 }

        
        statusTxExciterAutomaticChanged OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The Exciter Automatic has changed.
                There was a fault on one exciter which lead to this changeover."
            ::= { statusTxEntry 20 }

        
        statusTxExciterAutomaticFault OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The Exciter Automatic is faulty.
                In case of any fault on one exciter, there will be no switchover to the other exciter,
                because of this fault."
            ::= { statusTxEntry 21 }

        
        statusTxOstAutomaticReady OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The Outputstage Automatic is Ready.
                In case of any fault on one outputstage, there will be a switchover to the other outputstage.
                
                This paramter is only available for systems with an automatic output switch."
            ::= { statusTxEntry 22 }

        
        statusTxOstAutomaticChanged OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The Outputstage Automatic has changed.
                There was a fault on one outputstage which lead to this changeover.
                
                This paramter is only available for systems with an automatic output switch."
            ::= { statusTxEntry 23 }

        
        statusTxOstAutomaticFault OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The Outputstage Automatic is faulty.
                In case of any fault on one outputstage, there will be no switchover to the other outputstage,
                because of this fault.
                
                This paramter is only available for systems with an automatic output switch."
            ::= { statusTxEntry 24 }

        
        statusTxNoConnectionExcA OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "No Connection between NetCCU and Exciter."
            ::= { statusTxEntry 25 }

        
        statusTxNoConnectionOstA OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "No Connection between NetCCU and Outputstage."
            ::= { statusTxEntry 26 }

        
        statusTxNoConnectionExcB OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "No Connection between NetCCU and Exciter."
            ::= { statusTxEntry 27 }

        
        statusTxNoConnectionOstB OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "No Connection between NetCCU and Outputstage."
            ::= { statusTxEntry 28 }

        
        statusTxActiveExcA OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "ExciterA is currently active."
            ::= { statusTxEntry 29 }

        
        statusTxActiveOstA OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "OutputstageA is currently active."
            ::= { statusTxEntry 30 }

        
        statusTxActiveExcB OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "ExciterB is currently active."
            ::= { statusTxEntry 31 }

        
        statusTxActiveOstB OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "OutputstageB is currently active."
            ::= { statusTxEntry 32 }

        
        statusTxExcSwitch OBJECT-TYPE
            SYNTAX INTEGER
                {
                fault(1),
                excAToOstA(2),
                excBToOstA(3),
                excAToBothOst(4),
                excBToBothOst(5)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Current state of the exciter RF switch.
                
                In a PassivePa or ActivePa system
                value excAToOstA(2) implies that exciter B is connected to output stage B;
                and
                value excBToOstA(3) implies that exciter A is connected to output stage B.
                
                When the system is not SingleTx there is a corresponding preselection object:
                cmdTxPreselectExciter."
            ::= { statusTxEntry 33 }

        
        statusTxOstSwitch OBJECT-TYPE
            SYNTAX INTEGER
                {
                fault(1),
                ostAToAntenna(2),
                ostBToAntenna(3),
                bothToAntenna(4),
                bothToDummyLoad(5),
                undefined(6)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Current state of the output stage RF switch.
                
                In a PassivePa or ActivePa system
                value ostAToAntenna(2) implies that output stage B is connected to dummy load;
                and
                value ostBToAntenna(3) implies that output stage A is connected to dummy load.
                
                When the system is PassivePa or ActivePa with an automatic power switch
                there is a corresponding preselection object: cmdTxPreselectExciter."
            ::= { statusTxEntry 34 }

        
        statusTxNoConnectionApaIf OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "NetCCU can not communicate to the APA-Interface."
            ::= { statusTxEntry 35 }

        
        statusTxAbsorberFault OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Absorber fault occurred.
                "
            ::= { statusTxEntry 36 }

        
        statusTxPowerSupply OBJECT-TYPE
            SYNTAX FloatingPoint
            UNITS "volt"
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Monitoring value of the output voltages of the power supply."
            ::= { statusTxEntry 37 }

        
        statusTxAdditionalPowerSupply OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Shows whether the NetCCU has an additional (external) power supply."
            ::= { statusTxEntry 38 }

        
        statusTxInternalPowerSupply OBJECT-TYPE
            SYNTAX FloatingPoint
            UNITS "volt"
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Monitoring value of the output voltages of the internal power supply."
            ::= { statusTxEntry 39 }

        
        statusTxExternalPowerSupply OBJECT-TYPE
            SYNTAX FloatingPoint
            UNITS "volt"
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Monitoring value of the output voltages of the external power supply."
            ::= { statusTxEntry 40 }

        
        commandsOstTable OBJECT-TYPE
            SYNTAX SEQUENCE OF CommandsOstEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "This table contains important commands for the output stage."
            ::= { rsXx8000TxObjs 3 }

        
        commandsOstEntry OBJECT-TYPE
            SYNTAX CommandsOstEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "An entry (conceptual row) in the commandsOstTable."
            INDEX { cmdTxIdx, cmdDeviceIdx }
            ::= { commandsOstTable 1 }

        
        CommandsOstEntry ::=
            SEQUENCE { 
                cmdDeviceIdx
                    IndexAB,
                cmdOstRefVoltageVision
                    FloatingPoint,
                cmdOstMaxOutletTempThreshold
                    Integer32
             }

        cmdDeviceIdx OBJECT-TYPE
            SYNTAX IndexAB
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "This column is used to show parameters for both output stages,
                if you have transmitters with power reserve."
            ::= { commandsOstEntry 1 }

        
        cmdOstRefVoltageVision OBJECT-TYPE
            SYNTAX FloatingPoint
            UNITS "Percent"
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This adjusts the output power of the amplifier.
                This value is settable witch maximal 1 position after point (example 11.2)."
            ::= { commandsOstEntry 2 }

        
        cmdOstMaxOutletTempThreshold OBJECT-TYPE
            SYNTAX Integer32 (45..65)
            UNITS "Degree Celsius"
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This sets the threshold for the outlet temperature."
            ::= { commandsOstEntry 3 }

        
        statusOstTable OBJECT-TYPE
            SYNTAX SEQUENCE OF StatusOstEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "This table shows overall information for all output stages."
            ::= { rsXx8000TxObjs 4 }

        
        statusOstEntry OBJECT-TYPE
            SYNTAX StatusOstEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "An entry (conceptual row) in the statusOstTable."
            AUGMENTS { commandsOstEntry }
            ::= { statusOstTable 1 }

        
        StatusOstEntry ::=
            SEQUENCE { 
                statusOstForwardPower
                    FloatingPoint,
                statusOstReflectedPower

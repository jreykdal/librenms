        eventsTable OBJECT-TYPE
            SYNTAX SEQUENCE OF EventsEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "This table contains necessary information for handling alarms.
                For each alarm you have the following information:
                - name (get),
                - mask to enable/disable sending out (set/get),
                - priority (set/get) and
                - the current state (get only)."
            ::= { rsXx8000TxEvents 1 }

        
        eventsEntry OBJECT-TYPE
            SYNTAX EventsEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "An entry (conceptual row) in the eventsTable."
            INDEX { evtTxIdx, evtABIdx, evtRackIdx, evtAmpIdx, evtNameIdx
                 }
            ::= { eventsTable 1 }

        
        EventsEntry ::=
            SEQUENCE { 
                evtTxIdx
                    IndexTransmitter,
                evtABIdx
                    IndexAB,
                evtRackIdx
                    IndexRack,
                evtAmpIdx
                    IndexAmplifier,
                evtNameIdx
                    EventMaxEntryNumber,
                evtName
                    INTEGER,
                evtMask
                    EventMask,
                evtPriority
                    EventPriority,
                evtEvent
                    EventState
             }

        evtTxIdx OBJECT-TYPE
            SYNTAX IndexTransmitter
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "The transmitter index.
                This is a helper column and therefore not-accessible.."
            ::= { eventsEntry 1 }

        

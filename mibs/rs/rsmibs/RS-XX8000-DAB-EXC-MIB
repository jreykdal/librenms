        Select 'on' to use the values specified in cmdExcManualTIIMainId, cmdExcManualTIISubId."
      ::= { commandsEntry 22 }

    
    cmdExcNetCompensationDelayTS1 OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "micro sec"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "ETI 1 Network Compensation Delay.
        In static SFN mode this is used to ensure an equal delay
        between the multiplexer and the transmitter network adapter.
        In MFN mode the reserve channel delay will be automatically adjusted
        to achieve identical network delays for both ETI streams.
        In static SFN mode, the user is responsible for setting this delay according to the network topography.
        In dynamic SFN mode this delay is set through the TIST value from the multiplexer
        and is shown for information only.
        min: 0.000, max: 1000000.000"
      ::= { commandsEntry 23 }

    
    cmdExcNetCompensationDelayTS2 OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "micro sec"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "ETI 2 Network Compensation Delay.
        In static SFN mode this is used to ensure an equal delay
        between the multiplexer and the transmitter network adapter.
        In MFN mode the reserve channel delay will be automatically adjusted
        to achieve identical network delays for both ETI streams.
        In static SFN mode, the user is responsible for setting this delay according to the network topography.
        In dynamic SFN mode this delay is set through the TIST value from the multiplexer
        and is shown for information only.
        min: 0.000, max: 1000000.000"
      ::= { commandsEntry 24 }

    
    cmdExcDynamicSFNTISTSource OBJECT-TYPE
      SYNTAX INTEGER
        {
        etiLi(1),
        etiNa(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "selects the TIST source for both input channels in dynamic SFN mode"
      ::= { commandsEntry 25 }

    
    cmdExcDynamicSFNMaxTISTLevel OBJECT-TYPE
      SYNTAX INTEGER
        {
        level1(1),
        level2(2),
        level3(3),
        level4(4),
        level5(5)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The selected maximum TIST level.
        The higher the TIST level, the finer the delay time resolution."
      ::= { commandsEntry 26 }

    
    cmdExcSFNDeviationTime OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "Percent"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The maximum time deviation (as a % of the guard interval)
        between the required and actual transmission time
        above which a hard resynchronisation will occur.
        Below this threshold, the symbol rate will be regulated
        to reduce any discrepancies in the transmission time.
        min: 10.0, max: 100.0"
      ::= { commandsEntry 27 }

    
    cmdExcInputFailDelayTime OBJECT-TYPE
      SYNTAX Integer32 (0..600)
      UNITS "seconds"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION

    cmdTxIdx OBJECT-TYPE
      SYNTAX IndexTransmitter
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The transmitter index. "
      ::= { commandsEntry 1 }

    
    cmdExcIdx OBJECT-TYPE
      SYNTAX IndexAB
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "This index distinguishes the exiters.
        Necessary if you have dual drive transmitters."
      ::= { commandsEntry 2 }

    
    cmdExcOpModeInputAutomatic OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Activates/deactivates the input automatic. 
        If a loss of input signal is detected on the current input
        the reserve input will be used instead."
      ::= { commandsEntry 3 }

    
    cmdExcPreselectInput OBJECT-TYPE
      SYNTAX INTEGER
        {
        eti1(1),
        eti2(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This is used to select which input has priority (if enabled),
        otherwise this input is used first when the automatic input is turned on."
      ::= { commandsEntry 4 }

    
    cmdExcNetworkMode OBJECT-TYPE
      SYNTAX INTEGER
        {
        dynamicSFN(1),
        staticSFN(2),
        mfn(3)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Used to select the network mode.
        In Dynamic SFN mode, TIST warnings become active.
        In static SFN and MFN mode, the network compensation delays must be set such
        that the delay difference is 0 to allow seamless switching."
      ::= { commandsEntry 6 }

    
    cmdExcEnableTII OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Enables / disables transmission of Transmitter Identification Information."
      ::= { commandsEntry 7 }

    
    cmdExcTxAddress OBJECT-TYPE
      SYNTAX Integer32 (0..65535)
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The unique transmitter id used for addressing MNSC data."
      ::= { commandsEntry 9 }

    
    cmdExcInputPriority OBJECT-TYPE
      SYNTAX INTEGER
        {
        equal(1),
        prior(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Equal: There are no differences between both inputs. 
        If a failure on the current input is detected it will be switched to the reserve input. 
        It stays there until the reserve shows a failure. 
        Prior: Whenever possible a certain input shall be used. 
        If a failure is detected the reserve will be used as short as possible."
      ::= { commandsEntry 13 }

    
    cmdExcInputErrorFrmWindowLength OBJECT-TYPE
      SYNTAX Integer32 (1..999)
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The window length in ETI Frames used to average the CRC error rate.
        Corresponds with Q in ETSI EN 302 0777-1 section 4.3.2.3 ."
      ::= { commandsEntry 14 }

    
    cmdExcInputErrorFreeFrames OBJECT-TYPE
      SYNTAX Integer32 (1..999)
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The number of ETI Frames without any CRC errors, before the ETI stream is marked as present.
        Corresponds with M in ETSI EN 302 0777-1 section 4.3.2.3 ."
      ::= { commandsEntry 15 }

    
    cmdExcInputMaxEOHErrorRate OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "Percent"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The maximum end of header CRC error rate allowed (within the above-specified window length)
        before the ETI stream is marked as absent.
        Corresponds with P in ETSI EN 302 0777-1 section 4.3.2.3 .
        min: 0.0, max: 100.0"
      ::= { commandsEntry 16 }

    
    cmdExcInputMaxEOFErrorRate OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "Percent"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The maximum end of frame CRC error rate allowed (within the above-specified window length)
        before the ETI stream is marked as present.
        Corresponds with P in ETSI EN 302 0777-1 section 4.3.2.3 .
        min: 0.0, max: 100.0"
      ::= { commandsEntry 17 }

    

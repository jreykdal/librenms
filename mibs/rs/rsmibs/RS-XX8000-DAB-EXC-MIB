      ::= { commandsEntry 48 }

    
    cmdExcTestInserterMode OBJECT-TYPE
      SYNTAX INTEGER
        {
        off(1),
        testEnsemble(2),
        prbsOnly(3),
        testFicOverallTxDelay(4),
        testFicProcessingDelay(5)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "In Test Ensemble mode, a test ensemble will be inserted into the output stream.
        In PRBS mode, PRBS data will be inserted into an already existing sub-channel
        (from the active ETI input).
        The Test FIC Modes are used to measure the overall transmitter delay or processing delay.
        In these modes a specific data pattern will be inserted into ETI Frames
        with frame phase 0 and a period of 96 frames.
        A trigger pulse will appear at the Monitoring Output synchronous
        with the first bit of the selected ETI frames either at the transmitter input (Overall Tx Delay)
        or at the COFDM encoder input (Processing Delay).
        This corresponds with the test described in ETSI EN 302 077-1 V1.1.1 Annex C."
      ::= { commandsEntry 49 }

    

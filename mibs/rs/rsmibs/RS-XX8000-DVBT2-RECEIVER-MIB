-- *****************************************************************************
-- **          object definitions
-- *****************************************************************************
    rsXx8000DvbT2RcvObjs OBJECT IDENTIFIER ::= { rsXx8000DvbT2Rcv 1 }

    
    commandsTable OBJECT-TYPE
      SYNTAX SEQUENCE OF CommandsEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "This table contains all writable objects for the DVB-T2 receiver."
      ::= { rsXx8000DvbT2RcvObjs 1 }

    
    commandsEntry OBJECT-TYPE
      SYNTAX CommandsEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An entry (conceptual row) in the commandsTable."
      INDEX { cmdBoardIdx }
      ::= { commandsTable 1 }

    
    CommandsEntry ::=
      SEQUENCE { 
        cmdBoardIdx
          IndexAB,
        cmdCenterFrequency
          Unsigned32,
        cmdChannelBandwidth
          INTEGER,
        cmdPlpNumber
          Unsigned32,
        cmdPlpSelection
          INTEGER
       }

    cmdBoardIdx OBJECT-TYPE
      SYNTAX IndexAB
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The board index. "
      ::= { commandsEntry 1 }

    
    cmdCenterFrequency OBJECT-TYPE
      SYNTAX Unsigned32 (150000000..300000000 | 450000000..900000000)
      UNITS "Hz"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Tuner frequency."
      ::= { commandsEntry 2 }

    
    cmdChannelBandwidth OBJECT-TYPE
      SYNTAX INTEGER
        {
        mHz5(1),
        mHz6(2),
        mHz7(3),
        mHz8(4)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Channel bandwidth:
        mHz5(1) - 5MHz
        mHz6(2) - 6MHz
        mHz7(3) - 7MHz
        mHz8(4) - 8MHz"
      ::= { commandsEntry 3 }

    
    cmdPlpNumber OBJECT-TYPE
      SYNTAX Unsigned32 (0..255)
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Selects the PLP to process when cmdPlpSelection is manual(2)."
      ::= { commandsEntry 4 }

    
    cmdPlpSelection OBJECT-TYPE
      SYNTAX INTEGER
        {
        automatic(1),
        manual(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "In automatic(1) mode the DVB-T2 receiver selects the first detected PLP.
        In manual(2) mode the PLP given with cmdPlpNumber is used."
      ::= { commandsEntry 5 }

    
    limitsTable OBJECT-TYPE
      SYNTAX SEQUENCE OF LimitsEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "Thresholds for notification generation."
      ::= { rsXx8000DvbT2RcvObjs 2 }

    
    limitsEntry OBJECT-TYPE
      SYNTAX LimitsEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An entry (conceptual row) in the thresholdsTable."
      AUGMENTS { commandsEntry }
      ::= { limitsTable 1 }

    
    LimitsEntry ::=
      SEQUENCE { 
        limitMerWarning
          Unsigned32,
        limitMerFault
          Unsigned32,
        limitBerWarning
          Unsigned32,
        limitBerFault
          Unsigned32
       }

    limitMerWarning OBJECT-TYPE
      SYNTAX Unsigned32 (0..50)
      UNITS "dB"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Limit for generating the merWarning notification."
      ::= { limitsEntry 1 }

    
    limitMerFault OBJECT-TYPE
      SYNTAX Unsigned32 (0..50)
      UNITS "dB"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Limit for generating the merFault notification."
      ::= { limitsEntry 2 }

    
    limitBerWarning OBJECT-TYPE
      SYNTAX Unsigned32
      UNITS "10e-7"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Limit for generating the berWarning notification."
      ::= { limitsEntry 3 }

    
    limitBerFault OBJECT-TYPE
      SYNTAX Unsigned32
      UNITS "10e-7"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Limit for generating the berFault notification."
      ::= { limitsEntry 4 }

    
    generalInfoTable OBJECT-TYPE
      SYNTAX SEQUENCE OF GeneralInfoEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "DVB-T2 receiver measured values."
      ::= { rsXx8000DvbT2RcvObjs 3 }

    
    generalInfoEntry OBJECT-TYPE
      SYNTAX GeneralInfoEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An entry (conceptual row) in the generalInfoTable."
      AUGMENTS { commandsEntry }
      ::= { generalInfoTable 1 }

    
    GeneralInfoEntry ::=
      SEQUENCE { 
        giRfInputLevel
          Integer32,
        giMER
          Integer32,
        giBER
          Unsigned32,
        giLdpcIterations
          Unsigned32
       }

    giRfInputLevel OBJECT-TYPE
      SYNTAX Integer32
      UNITS "dBm / 10"
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The RF input level in tenth of dBm."
      ::= { generalInfoEntry 1 }

    
    giMER OBJECT-TYPE
      SYNTAX Integer32
      UNITS "dB / 10"
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The modulation error ration in tenth of dB"
      ::= { generalInfoEntry 2 }

    
    giBER OBJECT-TYPE
      SYNTAX Unsigned32
      UNITS "10e-7"
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "pre LDPC BER"
      ::= { generalInfoEntry 3 }

    
    giLdpcIterations OBJECT-TYPE
      SYNTAX Unsigned32
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Number of LDPC iterations."
      ::= { generalInfoEntry 4 }

    
    localizationTable OBJECT-TYPE
      SYNTAX SEQUENCE OF LocalizationEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "Identification of the transmitting system."
      ::= { rsXx8000DvbT2RcvObjs 4 }

    
    localizationEntry OBJECT-TYPE
      SYNTAX LocalizationEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An entry (conceptual row) in the identificationTable."
      AUGMENTS { commandsEntry }
      ::= { localizationTable 1 }

    
    LocalizationEntry ::=
      SEQUENCE { 
        networkID
          Unsigned32,
        t2SystemID
          Unsigned32,
        cellID
          Unsigned32,
        txIdAvailability
          Unsigned32
       }

    networkID OBJECT-TYPE
      SYNTAX Unsigned32
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Uniquely identifies the current DVB-T2 network."
      ::= { localizationEntry 1 }

    
    t2SystemID OBJECT-TYPE
      SYNTAX Unsigned32
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Uniquely identifies a T2 system within the DVB-T2 network."
      ::= { localizationEntry 2 }

    
    cellID OBJECT-TYPE
      SYNTAX Unsigned32
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Uniquely identifies a geographic cell in a DVB-T2 network.
        If the provision of the cell ID is not foreseen, the value of this field is '0'."
      ::= { localizationEntry 3 }

    
    txIdAvailability OBJECT-TYPE
      SYNTAX Unsigned32
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Signal the availability of transmitter identification signals within the current geographic cell.
        When no transmitter identification signals are used this field is set to 0x000.
        All other bit combinations are reserved for future use."
      ::= { localizationEntry 4 }

    
    l1FrameModulationTable OBJECT-TYPE
      SYNTAX SEQUENCE OF L1FrameModulationEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The L1-pre signalling enables the reception and decoding of the L1-post signalling."
      ::= { rsXx8000DvbT2RcvObjs 5 }

    
    l1FrameModulationEntry OBJECT-TYPE
      SYNTAX L1FrameModulationEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An entry (conceptual row) in the l1PreTable."
      AUGMENTS { commandsEntry }
      ::= { l1FrameModulationTable 1 }

    
    L1FrameModulationEntry ::=
      SEQUENCE { 
        l1FrModPreambleFormat
          INTEGER,
        l1FrModFFT
          INTEGER,
        l1L1ModBwtExt
          TruthValue,
        l1FrModConstellation
          INTEGER,
        l1FrModGuardInterval
          INTEGER,
        l1FrModPilotPattern
          INTEGER,
        l1FrModPAPR
          INTEGER
       }

    l1FrModPreambleFormat OBJECT-TYPE
      SYNTAX INTEGER
        {
        siso(1),
        miso(2),
        nonT2(3),
        unknown(4)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Identifies the format of the P2 symbol(s)."
      ::= { l1FrameModulationEntry 1 }

    
    l1FrModFFT OBJECT-TYPE
      SYNTAX INTEGER
        {
        m2K(1),
        m8K(2),
        m4K(3),
        m1K(4),
        m16K(5),
        m32K(6),
        unknown(7)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "FFT size:
        m2K  -  2K
        m8K  -  8K
        m4K  -  4K
        m1K  -  1K
        m16K - 16K
        m32K - 32K"
      ::= { l1FrameModulationEntry 2 }

    
    l1L1ModBwtExt OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Indicates whether the extended carrier mode is used in the case of 8K, 16K and 32K FFT sizes."
      ::= { l1FrameModulationEntry 3 }

    
    l1FrModConstellation OBJECT-TYPE
      SYNTAX INTEGER
        {
        bpsk(1),
        qpsk(2),
        qam16(3),
        qam64(4),
        unknown(5)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The L1-post constellation.
        "
      ::= { l1FrameModulationEntry 4 }

    
    l1FrModGuardInterval OBJECT-TYPE
      SYNTAX INTEGER
        {
        g1div32(1),
        g1div16(2),
        g1div8(3),
        g1div4(4),
        g1div128(5),
        g19div128(6),
        g19div256(7),
        unknown(8)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The guard interval of the current super-frame."
      ::= { l1FrameModulationEntry 5 }

    
    l1FrModPilotPattern OBJECT-TYPE
      SYNTAX INTEGER
        {
        pp1(1),
        pp2(2),
        pp3(3),
        pp4(4),
        pp5(5),
        pp6(6),
        pp7(7),
        pp8(8),
        unknown(9)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Indicates the scattered pilot pattern used for the data OFDM symbols."
      ::= { l1FrameModulationEntry 6 }

    
    l1FrModPAPR OBJECT-TYPE
      SYNTAX INTEGER
        {
        none(1),
        ace(2),
        tr(3),
        trAce(4),
        unknown(5)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Describes what kind of PAPR reduction is used, if any."
      ::= { l1FrameModulationEntry 7 }

    
    l1FrameStructureTable OBJECT-TYPE
      SYNTAX SEQUENCE OF L1FrameStructureEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "The L1-post signalling contains parameters which provide sufficient information
        for the receiver to decode the desired physical layer pipes."
      ::= { rsXx8000DvbT2RcvObjs 6 }

    
    l1FrameStructureEntry OBJECT-TYPE
      SYNTAX L1FrameStructureEntry
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "An entry (conceptual row) in the l1PostTable."

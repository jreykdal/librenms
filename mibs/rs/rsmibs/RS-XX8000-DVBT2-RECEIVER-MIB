      ::= { plpInfoTable 1 }

    
    PlpInfoEntry ::=
      SEQUENCE { 
        plpID
          Unsigned32,
        plpType
          INTEGER,
        plpGroupID
          Unsigned32,
        plpCodeRate
          INTEGER,
        plpConstellation
          INTEGER,
        plpRotation
          TruthValue,
        plpFEC
          INTEGER,
        plpTimeInterleaverLength

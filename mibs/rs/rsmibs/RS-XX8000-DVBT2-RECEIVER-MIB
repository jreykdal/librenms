        "initial revision
        changed giBER to pre LDPC
        and BER precision to 10e-7"
      REVISION "201011260800Z"		-- November 26, 2010 at 08:00 GMT
      DESCRIPTION 
        "preliminary revision"
      ::= { rsXx8000MibModule 300 }

    
  
  

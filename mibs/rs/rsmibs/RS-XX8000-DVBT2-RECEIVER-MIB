  RS-XX8000-DVBT2-RECEIVER-MIB DEFINITIONS ::= BEGIN
 
    IMPORTS
      rsXx8000, eventAlarmClass, indexTransmitter, indexAB, rsXx8000MibModule, 
      ReadableString, EventMaxEntryNumber, EventMask, EventPriority, EventState, 
      IndexAB      
        FROM RS-XX8000-COMMON-MIB      

      ::= { plpInfoEntry 2 }

    
    plpGroupID OBJECT-TYPE
      SYNTAX Unsigned32
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Identifies with which PLP group within the T2 system the current PLP is associated."
      ::= { plpInfoEntry 4 }

    
    plpCodeRate OBJECT-TYPE
      SYNTAX INTEGER
        {
        cr1div2(1),
        cr3div5(2),
        cr2div3(3),
        cr3div4(4),
        cr4div5(5),
        cr5div6(6),
        unknown(7)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Indicates the code rate used by the currently selected PLP."
      ::= { plpInfoEntry 5 }

    
    plpConstellation OBJECT-TYPE
      SYNTAX INTEGER
        {
        qpsk(1),
        qam16(2),
        qam64(3),
        qam256(4),
        unknown(5)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Indicates the modulation used by the currently selected PLP."
      ::= { plpInfoEntry 6 }

    
    plpRotation OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Indicates whether constellation rotation is in use or not
        by the currently selected PLP."
      ::= { plpInfoEntry 7 }

    
    plpFEC OBJECT-TYPE
      SYNTAX INTEGER
        {
        ldpc16k(1),
        ldpc64k(2),
        unknown(3)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Indicates the FEC type used by the currently selected PLP."
      ::= { plpInfoEntry 8 }

    
    plpTimeInterleaverLength OBJECT-TYPE
      SYNTAX Unsigned32
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The use of this field is determined by the values of the time interleaver type field."
      ::= { plpInfoEntry 11 }

    
    plpTimeInterleaverType OBJECT-TYPE
      SYNTAX Unsigned32
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Indicates the type of time-interleaving.
        A value of '0' indicates that one Interleaving Frame corresponds to one T2-frame
        and contains one or more TI-blocks.
        A value of '1' indicates that one Interleaving Frame is carried
        in more than one T2-frame and contains only one TI-block."
      ::= { plpInfoEntry 12 }

    
    productInfoTable OBJECT-TYPE
      SYNTAX SEQUENCE OF ProductInfoEntry

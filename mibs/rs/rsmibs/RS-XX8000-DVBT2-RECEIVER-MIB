      ::= { l1FrameStructureTable 1 }

    
    L1FrameStructureEntry ::=
      SEQUENCE { 
        l1FrStructNumberOfPLPs
          Unsigned32,
        l1FrStructNumberOfAux
          Unsigned32,
        l1FrStructCodeRate
          INTEGER,
        l1FrStructFEC
          INTEGER,
        l1FrStructRepetition
          TruthValue,
        l1FrStructNumberOfSymbols
          Unsigned32,
        l1FrStructNumberOfFrames
          Unsigned32
       }

    l1FrStructNumberOfPLPs OBJECT-TYPE
      SYNTAX Unsigned32
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Indicates the number of PLPs carried within the current super-frame."
      ::= { l1FrameStructureEntry 1 }

    
    l1FrStructNumberOfAux OBJECT-TYPE
      SYNTAX Unsigned32
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Indicates the number of auxiliary streams."
      ::= { l1FrameStructureEntry 2 }

    
    l1FrStructCodeRate OBJECT-TYPE
      SYNTAX INTEGER
        {
        cr1div2(1),
        unknown(2)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The L1-post code rate."
      ::= { l1FrameStructureEntry 3 }

    
    l1FrStructFEC OBJECT-TYPE
      SYNTAX INTEGER
        {
        ldpc16K(1),
        unknown(2)
        }
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Indicates the type of the L1 forward error correction (FEC) used
        for the L1-post signalling data block."
      ::= { l1FrameStructureEntry 4 }

    
    l1FrStructRepetition OBJECT-TYPE
      SYNTAX TruthValue
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "Indicates whether the dynamic L1-post signalling is provided also for the next frame."
      ::= { l1FrameStructureEntry 5 }

    
    l1FrStructNumberOfSymbols OBJECT-TYPE
      SYNTAX Unsigned32
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The number of data OFDM symbols per T2-frame, excluding P1 and P2."
      ::= { l1FrameStructureEntry 6 }

    
    l1FrStructNumberOfFrames OBJECT-TYPE
      SYNTAX Unsigned32
      MAX-ACCESS read-only
      STATUS current
      DESCRIPTION
        "The number of T2-frames per super-frame."
      ::= { l1FrameStructureEntry 7 }

    
    plpInfoTable OBJECT-TYPE
      SYNTAX SEQUENCE OF PlpInfoEntry

    rsXx8000DvbT2RcvMibModule MODULE-IDENTITY 
      LAST-UPDATED "201106100800Z"		-- June 10, 2011 at 08:00 GMT
      ORGANIZATION 
        "Rohde&Schwarz GmbH & Co. KG"
      CONTACT-INFO 

        rsXx8000DvbNp1 OBJECT-IDENTITY
            STATUS current
            DESCRIPTION 
                "Xx8000 DVB Nplus1 system."
            ::= { rsXx8000 5 }

        
-- *****************************************************************************
-- **          object definitions
-- *****************************************************************************
        rsXx8000DvbNp1Objs OBJECT IDENTIFIER ::= { rsXx8000DvbNp1 1 }

        
-- *****************************************************************************
-- **          NetCCU switchover unit
-- *****************************************************************************
        switchoverUnit OBJECT IDENTIFIER ::= { rsXx8000DvbNp1Objs 1 }

        
        operationModeAutomatic OBJECT-TYPE
            SYNTAX SwitchOnOff
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This switches the automatic switching-over of transmitters on or off.
                An equivalent would be pressing ON or OFF at the NSU frontpanel."
            ::= { switchoverUnit 1 }

        
        operationModePriority OBJECT-TYPE
            SYNTAX SwitchOnOff
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This switches the usage of priorities on or off.
                
                With priorities, you can set for each program a priority. 
                If a fault occurs on a transmitter sending out a program with higher priority, 
                a transmitter sending out a program with a lower priority will be switched to the more important program."
            ::= { switchoverUnit 2 }

        
        selectedTxToDummyLoad OBJECT-TYPE
            SYNTAX IndexTransmitter
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "The preselected transmitter to dummy load."
            ::= { switchoverUnit 3 }

        
        selectedInputTxB OBJECT-TYPE
            SYNTAX Integer32 (1..9)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "The preselected input of the reserve transmitter."
            ::= { switchoverUnit 4 }

        
        selectedParametersetTxB OBJECT-TYPE
            SYNTAX Integer32 (1..8)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "The preselected parameterset of the reserve transmitter.
                
                This is helpful when configuring the system and if doing tests with switching-over."
            ::= { switchoverUnit 5 }

        
        selectedChannelTxB OBJECT-TYPE
            SYNTAX INTEGER
                {
                undefined(1),
                channel1(2),
                channel2(3),
                channel3(4),
                channel4(5),
                channel5(6),
                channel6(7),
                channel7(8),
                channel8(9)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Both the input and the parameterset of the reserve transmitter.
                This OID is a combination of OIDs selectedInputTxB and selectedParametersetTxB.
                If you want to set this value, TxB (Reserve Transmitter) must be to dummy load.
                The value undefined(1) is only readable - it is not possible to set it (even TxB is to dummyload)."
            ::= { switchoverUnit 6 }

        
        resetAllFaults OBJECT-TYPE
            SYNTAX Trigger
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Reset all faults (in all modules).
                
                Practically you reset the whole system (NSU, and of all transmitters all NetCCUs, Exciters, Outputstages).
                An equivalent would be pressing RESET at the NSU frontpanel.
                
                A GET will always return idle(1). A SET idle(1) will return NO_ERROR without doing anything."
            ::= { switchoverUnit 7 }

        
        summaryFaultNSU OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates a summary fault of the switchover unit (NSU).
                true(1)  --> summary fault
                false(2) --> no summary fault
                
                There is a fault of at least one module (e.g. Exciter A of tx A2) which causes this summary fault.
                
                An equivalent would be the LED Fault at the NSU frontpanel."
            ::= { switchoverUnit 8 }

        
        summaryWarningNSU OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates a summary warning of the switchover unit (NSU).
                true(1)  --> summary warning
                false(2) --> no summary warning
                
                There is a warning of at least one module (e.g. Exciter A of tx A2) which causes this summary warning.
                
                An equivalent would be the LED Warning at the transmitters frontpanel."
            ::= { switchoverUnit 9 }

        
        localModeNSU OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates the local/remote-mode of the switchover unit (NSU).
                true(1)  --> local
                false(2) --> remote
                
                The NSU is eigther in local-mode or in remote-mode. 
                For security reasons it is not possible to set this value!
                
                An equivalent would the LED Local at the NSU frontpanel."
            ::= { switchoverUnit 10 }

        
        automaticReady OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates the state of the automatic.
                true(1)  --> ready
                false(2) --> not ready
                
                If it's ready, a switching-over (because of preselection or faults in a transmitter sending out a program) is possible."
            ::= { switchoverUnit 11 }

        
        automaticChanged OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates whether the automatic has switched over automatically.
                true(1)  --> switched over
                false(2) --> not switched over"
            ::= { switchoverUnit 12 }

        
        automaticFault OBJECT-TYPE
            SYNTAX TruthValue
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This indicates whether the automatic has a fault.
                true(1)  --> fault
                false(2) --> no fault"
            ::= { switchoverUnit 13 }

        
        logbookNSU OBJECT IDENTIFIER ::= { switchoverUnit 14 }

        
        nsuNumberOfEntries OBJECT-TYPE
            SYNTAX LogbookMaxEntryNumber
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The number of entries in switchover unit (NSU) logbook."
            ::= { logbookNSU 1 }

        
        nsuLogbookClear OBJECT-TYPE
            SYNTAX Trigger
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Clear logbook of the switchover unit (NSU)."
            ::= { logbookNSU 2 }

        
        nsuLogbookTable OBJECT-TYPE
            SYNTAX SEQUENCE OF NsuLogbookEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "NSU Logbook"
            ::= { logbookNSU 3 }

        
        nsuLogbookEntry OBJECT-TYPE
            SYNTAX NsuLogbookEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "A row (an entry) of a logbook."
            INDEX { nsuLogbookEntryIdx }
            ::= { nsuLogbookTable 1 }

        
        NsuLogbookEntry ::=
            SEQUENCE { 
                nsuLogbookEntryIdx
                    LogbookMaxEntryNumber,
                nsuLogbookEntryNbr
                    LogbookMaxEntryNumber,
                nsuLogbookType
                    EventClass,
                nsuLogbookSlope
                    LogbookEntrySlope,
                nsuLogbookMessage
                    LogbookEntryMessagesNSU,
                nsuLogbookDateTime
                    DateAndTime
             }

        nsuLogbookEntryIdx OBJECT-TYPE
            SYNTAX LogbookMaxEntryNumber
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "This is an increasing number from 1 to maximum. It is used as an index column for SNMP."
            ::= { nsuLogbookEntry 1 }

        
        nsuLogbookEntryNbr OBJECT-TYPE
            SYNTAX LogbookMaxEntryNumber
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This is the number of the logbook entry. It is an decreasing number from maximum down to 1."
            ::= { nsuLogbookEntry 2 }

        
        nsuLogbookType OBJECT-TYPE
            SYNTAX EventClass
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Can either be Fault, Warning or State."
            ::= { nsuLogbookEntry 3 }

        
        nsuLogbookSlope OBJECT-TYPE
            SYNTAX LogbookEntrySlope
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Either set (event raises) or reset (event disappears)"
            ::= { nsuLogbookEntry 4 }

        
        nsuLogbookMessage OBJECT-TYPE
            SYNTAX LogbookEntryMessagesNSU
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "See RS-XX8000-COMMON-MIB - TextualConvention - LogbookEntryMessagesNSU for details."
            ::= { nsuLogbookEntry 5 }

        
        nsuLogbookDateTime OBJECT-TYPE
            SYNTAX DateAndTime
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The time of the logbook entry."
            ::= { nsuLogbookEntry 6 }

        
        loadedTx OBJECT-TYPE
            SYNTAX IndexTransmitter
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The actual loaded Tx."
            ::= { switchoverUnit 15 }

        
        powerSupply OBJECT-TYPE
            SYNTAX FloatingPoint
            UNITS "volt"

        eventsNsuTable OBJECT-TYPE
            SYNTAX SEQUENCE OF EventsNsuEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "This table contains necessary information for handling alarms. 
                For each alarm you have the following information: 
                - name (get),
                - mask to enable/disable sending out (set/get),
                - priority (set/get) and 
                - the current state (get only)."
            ::= { eventNsu 1 }

        
        eventsNsuEntry OBJECT-TYPE
            SYNTAX EventsNsuEntry
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "An event entry always consists of 4 values:
                - name: an enumerated list of all possible notifications
                - mask: the corresponding mask (enable/disable)
                - priority: the corresponding priority (value in range 0..255)
                - event: the event itself (active/inactive)"
            INDEX { eventNsuIdx }
            ::= { eventsNsuTable 1 }

        
        EventsNsuEntry ::=
            SEQUENCE { 
                eventNsuIdx
                    EventMaxEntryNumber,
                eventNsuName
                    INTEGER,
                eventNsuMask
                    EventMask,
                eventNsuPriority
                    EventPriority,
                eventNsuEvent
                    EventState
             }

        eventNsuIdx OBJECT-TYPE
            SYNTAX EventMaxEntryNumber
            MAX-ACCESS not-accessible
            STATUS current
            DESCRIPTION
                "The event number as integer."
            ::= { eventsNsuEntry 1 }

        
        eventNsuName OBJECT-TYPE
            SYNTAX INTEGER
                {
                nsuSummaryFault(1),
                nsuSummaryWarning(2),
                nsuLocal(3),
                nsuAutomaticReady(4),
                nsuAutomaticChanged(5),
                nsuFanWarning(6),
                nsuBoardTemperatureFault(7),
                nsuPowerSupply(8),
                nsuAutomaticFault(9),
                nsuInputSwitcherFault(10),
                nsuInternalPowerSupplyWarning(11),
                nsuExternalPowerSupplyWarning(12),
                nsuBoardTemperatureWarning(13)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "The event number as integer and the value as readable text."
            ::= { eventsNsuEntry 2 }

        

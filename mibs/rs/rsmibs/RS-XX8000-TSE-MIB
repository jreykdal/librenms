        inputAutomatic OBJECT IDENTIFIER ::= { input 2 }

        
        inpAutoPreselection OBJECT-TYPE
            SYNTAX INTEGER
                {
                input1(1),
                input2(2)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Possibility to manually change input.
                It's - contrary to its name - not a preselection, but a selection.
                The current value always follows the automatic change of active input.
                You cannot change this value if inpAutoPreferred is
                input1(1) or input2(3), inpAutoOperationMode is on(1)
                and inpAutoSwitchDirection is toReserveNback(1)."
            ::= { inputAutomatic 1 }

        
        inpAutoOperationMode OBJECT-TYPE
            SYNTAX SwitchOnOff
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Activates/deactivates the input automatic.
                If a loss of input signal is detected on the current input
                and the input automatic is active
                the reserve input will be used."
            ::= { inputAutomatic 2 }

        
        inpAutoPriority OBJECT-TYPE
            SYNTAX INTEGER
                {
                equal(1),
                prior(2)
                }
            MAX-ACCESS read-write
            STATUS deprecated
            DESCRIPTION
                "equal(1) - there are no differences between both inputs.
                If a failure on the current input is detected it will be switched to the reserve input.
                It stays there until the reserve shows a failure.
                prior(2) - whenever possible the input selected with inpAutoPreselection shall be used.
                If a failure is detected the reserve will be used as short as possible.
                
                This object is now deprecated.
                Please use inpAutoPreferred instead."
            ::= { inputAutomatic 3 }

        
        inpAutoCheckTimeForward OBJECT-TYPE
            SYNTAX Unsigned32 (0..600)
            UNITS "second"
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This time has to elapse before the current input switches to the reserve input."
            ::= { inputAutomatic 4 }

        
        inpAutoCheckTimeBack OBJECT-TYPE
            SYNTAX Unsigned32 (0..600)
            UNITS "second"
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This time has to elapse before the automatic switches back from the reserve
                to the preselected input.
                This value takes no effect if inpAutoPriority is equal(1)."
            ::= { inputAutomatic 5 }

        
        inpAutoPreferred OBJECT-TYPE
            SYNTAX INTEGER
                {
                input1(1),
                none(2),
                input2(3)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Determines the preferred input for the input automatic,
                or no preference.
                This only configures the input automatic.
                For manual input selection use inpAutoPreselection."
            ::= { inputAutomatic 6 }

        
        inpAutoSwitchDirection OBJECT-TYPE
            SYNTAX INTEGER
                {
                toReserveNback(1),
                toReserveOnly(2)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "toReserveNback(1) - switches with or without preferred input to reserve
                                    and - if conditions permit this - also back
                toReserveOnly(2)  - switches to reserve only.
                                    Switch back has to be done with inpAutoPreselection."
            ::= { inputAutomatic 7 }

        
        inpAutoPreDelayActiveInput OBJECT-TYPE
            SYNTAX Integer32
            UNITS "milli second"
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "In MFN mode seamless switching is possible
                if both input TS are identical.
                To this the input TS are delayed and correlated,
                a time stamp is not necessary.
                To facilitate correlation a max pre-delay of active input
                is set in delay FIFO. Reserve input must not arrive
                this amount later than active input."
            ::= { inputAutomatic 8 }

        
        inpAutoDelayInput1To2 OBJECT-TYPE
            SYNTAX Integer32
            UNITS "milli second"
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "This measured value shows the necessary delay in seamles module.
                If seamless is not possible, this value is not valid."
            ::= { inputAutomatic 9 }

        

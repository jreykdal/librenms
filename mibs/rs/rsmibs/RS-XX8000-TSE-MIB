            DESCRIPTION
                "Shows the source currently used for frequency synchronization."
            ::= { frqRgStatus 1 }

        
        frqRgReferenceState OBJECT-TYPE
            SYNTAX INTEGER
                {
                fail(1),
                warning(2),
                ok(3)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Shows the state of the currently used reference.
                In SFN a reference failure may lead to an error
                that results in an exciter switch-over.
                "
            ::= { frqRgStatus 2 }

        
        frqRgControllerState OBJECT-TYPE
            SYNTAX INTEGER
                {
                unknown(1),
                inaccurate(2),
                good(3),
                standsGuardTime(4)
                }
            MAX-ACCESS read-only
            STATUS current
            DESCRIPTION
                "Shows the frequency precision of the controller.
                Only at least 24 hours after switching on the exciter
                the highest possible precision - standsGuardTime(4) - is reached.
                Only then it is assured that a reference fail does not lead to SFN error
                during guard time."
            ::= { frqRgStatus 3 }

        
        frqRgConfiguration OBJECT IDENTIFIER ::= { frequencyRegulation 2 }

        
        frqRgSource OBJECT-TYPE
            SYNTAX INTEGER
                {
                manual(1),
                external5MHz(2),
                external10MHz(3),
                external1PPS(4),
                internalGPS(5),
                auto(6)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Selects the appropriate reference source.
                If auto(6) is selected and several sources are available,
                an external reference is preferred to internal GPS.
                If manual(1) is selected, the internal crystal oscillator (OCXO)
                can be adjusted manually and no external reference is used
                (not applicable for SFN).
                "
            ::= { frqRgConfiguration 1 }

        
        frqRgControllerMode OBJECT-TYPE
            SYNTAX INTEGER
                {
                standard(1),
                regardJitter(2)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "If an external reference source with high jitter is used,
                the selection of regardJitter(2) can result in a better frequency stability.
                For a 'good' reference source the selection should be standard(1), because
                the control needs considerable more time to reach maximum frequency stability.
                If internal GPS is used, regardJitter(2) is selected automatically."
            ::= { frqRgConfiguration 2 }

        
        frqRgGuardTime OBJECT-TYPE
            SYNTAX Integer32 (0..24)
            UNITS "hour"
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "This value defines how many hours signal processing shall go on
                without synchronization after reference failed.
                This guard time becomes active only if at the time when reference
                failed the frequency stability was good.
                The greater this value is choosen,
                the more worsens the accuracy of transmitter frequency.
                Furthermore the transmitting time of the signal shifts.
                "
            ::= { frqRgConfiguration 3 }

        
        frqRgMuteOnFail OBJECT-TYPE
            SYNTAX INTEGER
                {
                never(1),
                onlyAtStartup(2),
                ifGuardTimeExpires(3)
                }
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Defines the action taken in case of reference source failure.
                never(1) - Muting is never done.
                      This leads to SFN errors, especially after power failure.
                onlyAtStartup(2) - After power failure muting is done until the control is synchronized.
                      If reference fails, the transmitter will continue to work as long as possible.
                ifGuardTimeExpires(3) - Muting is done not only after power failure,
                      but also if reference fails and guard time has expired."
            ::= { frqRgConfiguration 4 }

        
        frqRgManualOCXOadjust OBJECT-TYPE
            SYNTAX Integer32 (0..65535)
            MAX-ACCESS read-write
            STATUS current
            DESCRIPTION
                "Offers manual adjustment of the internal crystal oscillator.
                This requires connecting a frequency counter,
                which is synchronized by a high precision reference,
                to the monitor output."
            ::= { frqRgConfiguration 5 }

        

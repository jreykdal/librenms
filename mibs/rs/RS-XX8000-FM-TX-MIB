    cmdTxResetSumFault OBJECT-TYPE
      SYNTAX Trigger
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Reset all faults (in all modules) of the transmitter.
        
        You reset a designated transmitter (NetCCU, Exciters, Outputstages).
        An equivalent would be pressing RESET at this transmitters frontpanel.
        
        A GET will always return idle(1). A SET idle(1) will return NO_ERROR without doing anything."
      ::= { commandsTxEntry 1 }

    
    cmdTxParametersetLoad OBJECT-TYPE
      SYNTAX Integer32 (1..8)
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This loads the desired parameter set."
      ::= { commandsTxEntry 2 }

    
    cmdTxParametersetSave OBJECT-TYPE
      SYNTAX Integer32 (1..8)
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This saves the current settings to a designated parameter set."
      ::= { commandsTxEntry 3 }

    
    cmdTxParametersetReSave OBJECT-TYPE
      SYNTAX Trigger
      MAX-ACCESS read-write
      STATUS obsolete
      DESCRIPTION
        "This saves the changes to the current parameter set."
      ::= { commandsTxEntry 4 }

    
    cmdTxOperationModeProgram OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This switches the program path of the transmitter on/off."
      ::= { commandsTxEntry 5 }

    
    cmdTxOperationModeReserve OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This switches the reserve path of the transmitter on/off."
      ::= { commandsTxEntry 6 }

    
    cmdTxOpModeExcAutomatic OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This switches the exciter automatic on/off."
      ::= { commandsTxEntry 7 }

    
    cmdTxOpModeOstAutomatic OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This switches the outputstage automatic on/off.
        
        This paramter is only available for systems with an automatic output switch."
      ::= { commandsTxEntry 8 }

    
    cmdTxPreselectExciter OBJECT-TYPE
      SYNTAX INTEGER
        {
        exciterA(1),
        exciterB(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This sets exciterA or exciterB to program path (antenna) of the transmitter."
      ::= { commandsTxEntry 9 }

    
    cmdTxPreselectOutputstage OBJECT-TYPE
      SYNTAX INTEGER
        {
        outputstageA(1),
        outputstageB(2),
        bothToAntenna(3),
        bothToDummyLoad(4)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This sets 
        - outputstageA or 
        - outputstageB or
        - both
        to program path (antenna) of the transmitter,
        or it sets both to dummyload.
        
        The settings bothToAntenna(3) and bothToDummyLoad(4) are only settable 
        for ActiveReserve systems.
        
        This paramter is only available for systems with an automatic output switch."
      ::= { commandsTxEntry 10 }

    
    cmdTxDelayTimeExcAutomatic OBJECT-TYPE
      SYNTAX Integer32 (1..60)
      UNITS "seconds"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This sets the exciter automatic delay time."
      ::= { commandsTxEntry 11 }

    
    cmdTxDelayTimeOstAutomatic OBJECT-TYPE
      SYNTAX Integer32 (1..60)
      UNITS "seconds"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "This sets the outputstage automatic delay time.
        
        This paramter is only available for systems with an automatic output switch."
      ::= { commandsTxEntry 12 }

    
    cmdTxRfSwitch OBJECT-TYPE
      SYNTAX INTEGER
        {
        antenna(1),
        dummyLoad(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "RF switch for single-ended systems."
      ::= { commandsTxEntry 13 }

    
    cmdDeviceIdx OBJECT-TYPE
      SYNTAX IndexAB
      MAX-ACCESS not-accessible
      STATUS current
      DESCRIPTION
        "This column is used to show parameters for both exiters, if you have 
        dualdrive transmitters."
      ::= { commandsTxEntry 30 }

    
    cmdExcReset OBJECT-TYPE
      SYNTAX Trigger
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Reset all Exciter faults:
        idle(1)    --> ready, do nothing
        trigger(2) --> do now
            
        A GET will always return idle(1). 
        A SET idle(1) will return NO_ERROR without doing anything.
        "
      ::= { commandsTxEntry 31 }

    
    cmdExcRFOnOff OBJECT-TYPE
      SYNTAX SwitchOnOff
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Switches the RF on/off. It has the same behaviour as the switch 
        on the front panel of the exciter. This setting is only editable, 
        if there is no NetCCU connected!"
      ::= { commandsTxEntry 32 }

    
    cmdExcNoInputSeverity OBJECT-TYPE
      SYNTAX INTEGER
        {
        warning(1),
        fail(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "If WARNING is selected only a warning is produced when the 
        input signal is no longer present. If FAULT is selected an 
        additional sum fault is produced after the fail delay time. 
        This will cause a switchover to a reserve exciter. "
      ::= { commandsTxEntry 33 }

    
    cmdExcNoInputFailDelay OBJECT-TYPE
      SYNTAX Integer32 (0..600)
      UNITS "sec"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Adjust the time between detecting a loss of input signal and raising a failure."
      ::= { commandsTxEntry 34 }

    
    cmdExcInputLevelAnalog OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "dBu"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Selects the input level for the analog audio input (-6.0 ... 12.0). 
        A 500Hz sinusoidal tone with this input level will cause the 
        reference deviation in the output signal.Note: If preemphasis 
        is on, the nominal input level is not equal to the real signal 
        level due to the preemphasis gain."
      ::= { commandsTxEntry 35 }

    
    cmdExcInputLevelMPX OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "dBu"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Selects the input level for MPX (composite) input (-1.0 ... 16.0). 
        This input level will cause the reference deviation in the output signal. "
      ::= { commandsTxEntry 36 }

    
    cmdExcInputLevelAES OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "dBFS"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Selects the input level for the AES/EBU audio input (-15.0 ... 0.0). 
        A 500Hz sinusoidal tone with this input level will cause the 
        reference deviation in the output signal.
        Note: If preemphasis is on, the nominal input level is not 
        equal to the real signal level due to the preemphasis gain."
      ::= { commandsTxEntry 37 }

    
    cmdExcAnalogImpedance OBJECT-TYPE
      SYNTAX INTEGER
        {
        ohm600(1),
        ohmGreaterThan2000(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Selects the input impedance for analog inputs. 
        Usually it is > 2000 Ohms."
      ::= { commandsTxEntry 38 }

    
    cmdExcMPXImpedance OBJECT-TYPE
      SYNTAX INTEGER
        {
        ohm600(1),
        ohmGreaterThan2000(2)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Selects the input impedance for MPX (composite) inputs. 
        Usually it is > 2000 Ohms. The device uses this impedance 
        even if it is modulated with MPX from input 2 or input 3."
      ::= { commandsTxEntry 39 }

    
    cmdExcAFThreshold OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "perCent"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Threshold for AF signal monitoring (2.0 ... 80.0). 
        This threshold can be set as a percentage of the nominal 
        level or as an absolute value in dBu. The internal logic 
        uses the percent value. If the level input was in dBu, 
        it will be rounded to the nearest integer percent value."
      ::= { commandsTxEntry 40 }

    
    cmdExcAFOnTime OBJECT-TYPE
      SYNTAX Integer32 (1..6000)
      UNITS "sec"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The signal state is OK, if the signal level above 
        the threshold for at least this time period."
      ::= { commandsTxEntry 41 }

    
    cmdExcAFOffTime OBJECT-TYPE
      SYNTAX Integer32 (1..6000)
      UNITS "sec"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The signal state is not OK, if the signal level below 
        the threshold for at least this time period."
      ::= { commandsTxEntry 42 }

    
    cmdExcAFThresholddBu OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "dBu"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Threshold for AF signal monitoring (-100.0 ... 12.0). 
        This threshold can be set as a percentage of the nominal 
        level or as an absolute value in dBu. The internal logic 
        uses the percent value. If the level input was in dBu, 
        it will be rounded to the nearest integer percent value."
      ::= { commandsTxEntry 43 }

    
    cmdExcMPXThreshold OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "perCent"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Threshold for MPX (composite) signal monitoring (2.0 ... 80.0). 
        This threshold can be set as a percentage of the nominal level 
        or as an absolute value in dBu. The internal logic uses the 
        percent value. If the level input was in dBu, it will be rounded 
        to the nearest integer percent value."
      ::= { commandsTxEntry 44 }

    
    cmdExcMPXOnTime OBJECT-TYPE
      SYNTAX Integer32 (1..6000)
      UNITS "sec"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The signal state is OK, if the signal level above 
        the threshold for at least this time period."
      ::= { commandsTxEntry 45 }

    
    cmdExcMPXOffTime OBJECT-TYPE
      SYNTAX Integer32 (1..6000)
      UNITS "sec"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The signal state is not OK, if the signal level below 
        the threshold for at least this time period."
      ::= { commandsTxEntry 46 }

    
    cmdExcMPXThresholddBu OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "dBu"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Threshold for MPX (composite) signal monitoring (-100.0 ... 16.0). 
        This threshold can be set as a percentage of the nominal level 
        or as an absolute value in dBu. The internal logic uses the 
        percent value. If the level input was in dBu, it will be rounded 
        to the nearest integer percent value."
      ::= { commandsTxEntry 47 }

    
    cmdExcAESThreshold OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "perCent"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Threshold for audio signal monitoring (2.0 ... 80.0), 
        i.e. the monitoring of the audio levels within the AES signal.
        This threshold can be set as a percentage of the nominal level or as an absolute value in dBFs. 
        The internal logic uses the percent value. If the level input was 
        in dBFs, it will be rounded to the nearest integer percent value."
      ::= { commandsTxEntry 48 }

    
    cmdExcAESOnTime OBJECT-TYPE
      SYNTAX Integer32 (1..6000)
      UNITS "sec"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The signal state is OK, if the signal level is above 
        the threshold for at least this time period."
      ::= { commandsTxEntry 49 }

    
    cmdExcAESOffTime OBJECT-TYPE
      SYNTAX Integer32 (1..6000)
      UNITS "sec"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "The signal state is not OK, if the signal level is below 
        the threshold for at least this time period."
      ::= { commandsTxEntry 50 }

    
    cmdExcAESThresholddBFs OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "dBFS"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Threshold for audio signal monitoring (-100.0 ... 0.0),
        i.e. the monitoring of the audio levels within the AES signal.
        This threshold can be set as a percentage of the nominal level or as an absolute value in dBFs.
        The internal logic uses the percent value.
        If the level input was in dBFs, it will be rounded to the nearest integer percent value."
      ::= { commandsTxEntry 51 }

    
    cmdExcInputLevelAUX1 OBJECT-TYPE
      SYNTAX FloatingPoint
      UNITS "dBu"
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Selects the input level for the AUX1 input (-18.0 ... -7.0). 
        A 60 kHz sinusoidal tone with this input level will cause 
        the nominal deviation for this input in the output signal. "
      ::= { commandsTxEntry 52 }

    

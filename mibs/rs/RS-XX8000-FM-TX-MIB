    cmdExcCH1ModType OBJECT-TYPE
      SYNTAX INTEGER
        {
        afMonoL(1),
        afMonoR(2),
        afMonoLR(3),
        afStereo(4),
        aesMonoL(5),
        aesMonoR(6),
        aesMonoLR(7),
        aesStereo(8),
        mpxInp2(9),
        mpxInp3(10)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Selects the audio modulation source for the primary input channel. 
        It must be a different input source from the secondary channel. 
        It can be either digital (AES/EBU) or analog (AF or Composite). 
        For AF and AES/EBU (Input 3) you can select between Mono Right (Input 1) 
        or Mono Left (Input 2), Mono Left + Right and Stereo. Composite (MPX) 
        can only selected once, either for the primary or the secondary channel. 
        For Composite (MPX) you can select between Input 2 and Input 3. 
        Note: 
        Invalid combinations for primary and secondary channel are automatically 
        masked out. If the desired mode is not available, try setting the 
        secondary channel to 'Not Used'."
      ::= { commandsTxEntry 73 }

    
    cmdExcCH2ModType OBJECT-TYPE
      SYNTAX INTEGER
        {
        afMonoL(1),
        afMonoR(2),
        afMonoLR(3),
        afStereo(4),
        aesMonoL(5),
        aesMonoR(6),
        aesMonoLR(7),
        aesStereo(8),
        mpxInp2(9),
        mpxInp3(10),
        notUsed(11)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Selects the audio modulation source for the secondary input channel. 
        If defined, it must be a different input source from the primary channel. 
        It can be either digital (AES/EBU) or analog (AF or Composite). 
        For AF and AES/EBU (Input 3) you can select between Mono Right (Input 1) 
        or Mono Left (Input 2), Mono Left + Right and Stereo. Composite (MPX) 
        can only selected once, either for the primary or the secondary channel. 
        For Composite (MPX) you can select between Input 2 and Input 3. 
        Note: 
        Invalid combinations for primary and secondary channel are 
        automatically masked out."
      ::= { commandsTxEntry 74 }

    
    cmdExcModSelection OBJECT-TYPE
      SYNTAX INTEGER
        {
        ch1(1),
        ch2(2),
        autoSelect(3)
        }
      MAX-ACCESS read-write
      STATUS current
      DESCRIPTION
        "Select the input channel for audio modulation. 
        If a second channel is defined, the option 'Auto' and 'Ch.2' is available. 
        In this mode, the device switches automatically to the primary channel 
        if it is OK, if the primary channel is not OK and if the secondary 
        channel is OK, than it switches to the secondary channel. 
        It will automatically switch back as soon as the primary channel is OK 
        again. If both channels are not OK, it switches to the primary channel."
      ::= { commandsTxEntry 75 }

    
